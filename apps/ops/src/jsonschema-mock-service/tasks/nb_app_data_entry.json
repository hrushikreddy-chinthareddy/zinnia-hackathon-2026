                                            "dataType": "ssn",
                                            "ui:field": "subTitle"
                                        }
                                    }
                                },
                                "purchaseDocument": {
                                    "type": "object",
                                    "title": "",
                                    "label": true,
                                    "properties": {
                                        "documentName": {
                                            "type": "string",
                                            "title": "Document Name",
                                            "ui:field": "title"
