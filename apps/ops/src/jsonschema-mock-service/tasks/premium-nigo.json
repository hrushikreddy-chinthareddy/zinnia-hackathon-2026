{
    "formId": "aed4a1af-428d-4467-9fdd-07ecc3f3e239",
    "process": "New Business",
    "carrier": "WELB",
    "taskType": "NB_PAYMENT_PROCESSING_NIGO",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Review Premium Issues",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "processingReason": {
                                        "type": "string",
                                        "title": "Issues"
                                    },
                                    "processingResolution": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },

                        "details": {
                            "type": "object",
                            "title": "Details",
                            "properties": {
                                "paymentRecord": {
                                    "type": "object",
                                    "properties": {
                                        "grossAmount": {
                                            "type": "number",
                                            "title": "Gross Amount"
                                        },
                                        "netAmount": {
                                            "type": "number",
                                            "title": "Net amount"
                                        },
                                        "amountReceived": {
                                            "type": "number",
                                            "title": "Amount Received"
                                        }
                                    }
                                },
                                "document": {
                                    "type": "object",
                                    "properties": {
                                        "documentName": {
                                            "type": "string"
                                        },
                                        "documentId": {
                                            "type": "string"
                                        },
                                        "documentSource": {
                                            "type": "string"
                                        },
                                        "createdDate": {
                                            "type": "string"
                                        },
                                        "carrier": {
                                            "type": "string",
                                            "default": "{{carrier}}"
                                        }
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "enumNames": ["Yes", "No"],
                            "enum": [true, false],
                            "title": "Can you resolve the issues?"
                        },
                        "uploadDocuments": {
                            "type": "object",
                            "title": "Link or upload document",
                            "properties": {
                                "upload": {
                                    "type": "string"
                                },
                                "or": {
                                    "type": "string",
                                    "title": "or"
                                },
                                "attachment": {
                                    "type": "array",
                                    "title": "upload",
                                    "items": {
                                        "title": "upload",
                                        "type": "string",
                                        "format": "data-url"
                                    }
                                }
                            }
                        },
                        "attachments": {
                            "type": "array",
                            "items": {
                                "documentName": {
                                    "title": "Name",
                                    "type": "string"
                                },
                                "documentId": {
                                    "title": "Document Id",
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "required": ["issueResolved"],
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": true
                                        },
                                        "effectiveAmount": {
                                            "type": "object",
                                            "title": "Amount to apply",
                                            "properties": {
                                                "grossAmount": {
                                                    "type": "number",
                                                    "title": "Gross Amount"
                                                },
                                                "netAmount": {
                                                    "type": "number",
                                                    "title": "Net amount"
                                                }
                                            }
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": false
                                        },
                                        "reason": {
                                            "type": "object",
                                            "title": "The status reason for the task will be set to:"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                },
                "uiSchema": {
                    "ui:order": ["issuesList", "details", "issueResolved", "effectiveAmount", "reason", "uploadDocuments", "attachments"],
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },
                            "processingReason": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "processingResolution": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:options": {
                                    "label": false
                                }
                            }
                        }
                    },

                    "details": {
                        "ui:options": {
                            "label": false
                        },
                        "paymentRecord": {
                            "ui:options": {
                                "label": false
                            },
                            "grossAmount": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true,
                                    "dataType": "amount"
                                }
                            },
                            "netAmount": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true,
                                    "dataType": "amount"
                                }
                            },
                            "amountReceived": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true,
                                    "dataType": "amount"
                                }
                            }
                        },
                        "document": {
                            "ui:options": {
                                "canAdd": false,
                                "label": false,
                                "cardType": "Document",
                                "icon": "DOCUMENT_TEXT",
                                "ObjectFieldTemplate": "CardTemplate"
                            }
                        }
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "inline": true
                        },
                        "ui:hideError": true
                    },
                    "uploadDocuments": {
                        "inline": true,
                        "ui:options": {
                            "label": true,
                            "omitValue": true
                        },
                        "upload": {
                            "ui:widget": "AutoCompleteWidget",
                            "ui:placeholder": "Find existing documents...",
                            "ui:options": {
                                "label": false,
                                "icon": "Search"
                            }
                        },
                        "or": {
                            "ui:options": {
                                "label": false,
                                "inline": true
                            }
                        },
                        "attachment": {
                            "ui:options": {
                                "label": false,
                                "showFiles": false
                            },
                            "ui:props": {
                                "apiUrl": "case/v1/form/metadata?process=Common&taskType=UI_UPLOAD_DOCUMENT&carrier=null",
                                "apiMethod": "get"
                            }
                        }
                    },
                    "attachments": {
                        "ui:options": {
                            "label": false,
                            "addable": false,
                            "removable": true,
                            "ArrayFieldTemplate": "FileInfoTemplate"
                        }
                    },
                    "reason": {
                        "props": {
                            "description": "NIGO's unable to be resolved"
                        },
                        "ui:options": {
                            "label": true,
                            "ObjectFieldTemplate": "InstructionsTemplate"
                        }
                    },
                    "effectiveAmount": {
                        "grossAmount": {
                            "ui:options": {
                                "widget": "ValueWidget",
                                "placeholder": "Gross amount"
                            }
                        },
                        "netAmount": {
                            "ui:options": {
                                "widget": "ValueWidget",
                                "placeholder": "Net amount"
                            }
                        }
                    }
                }
            }
        ]
    }
}
