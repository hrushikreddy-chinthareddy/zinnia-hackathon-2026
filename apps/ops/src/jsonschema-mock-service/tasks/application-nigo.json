{
    "formId": "bf4a42d8-696f-4407-ac96-3010a2b72097",
    "process": "New Business",
    "carrier": "WELB",
    "taskType": "NB_APPLICATION_NIGO",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Review Application Issues",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "processingReason": {
                                        "type": "string",
                                        "title": "Issues"
                                    },
                                    "processingResolution": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },
                        "details": {
                            "type": "object",
                            "title": "Supporting Information",
                            "properties": {
                                "onwerDetails": {
                                    "type": "object",
                                    "properties": {
                                        "firstName": {
                                            "type": "string",
                                            "title": "First Name",
                                            "ui:field": "title"
                                        },
                                        "ssn": {
                                            "type": "string",
                                            "title": "SSN",
                                            "ui:field": "subTitle"
                                        },
                                        "lastName": {
                                            "type": "string",
                                            "title": "Last Name",
                                            "ui:field": "title"
                                        }
                                    }
                                },
                                "documentDetails": {
                                    "type": "object",
                                    "properties": {
                                        "documentId": {
                                            "type": "string",
                                            "ui:field": "subTitle"
                                        },
                                        "documentSource": {
                                            "type": "string",
                                            "ui:field": "title"
                                        },
                                        "carrier": {
                                            "type": "string",
                                            "default": "{{carrier}}"
                                        }
                                    }
                                }
                            }
                        },
                        "yesDisabled": {
                            "type": "array",
                            "title": "Can you resolve the issues?",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "reason": {
                                        "type": "string"
                                    }
                                }
                            },
                            "default": [
                                {
                                    "reason": "Online updates unavailable. Resubmission required"
                                }
                            ]
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "enumNames": ["Yes", "No"],
                            "enum": [true, false]
                        },
                        "uploadDocuments": {
                            "type": "object",
                            "title": "Link or upload document",
                            "properties": {
                                "upload": {
                                    "type": "string"
                                },
                                "or": {
                                    "type": "string",
                                    "title": "or"
                                },
                                "attachment": {
                                    "type": "array",
                                    "title": "upload",
                                    "items": {
                                        "title": "upload",
                                        "type": "string",
                                        "format": "data-url"
                                    }
                                }
                            }
                        },
                        "attachments": {
                            "type": "array",
                            "items": {
                                "documentName": {
                                    "title": "Name",
                                    "type": "string"
                                },
                                "documentId": {
                                    "title": "Document Id",
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "required": ["issueResolved"],
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "enum": [true]
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "enum": [false]
                                        },
                                        "communicationSent": {
                                            "type": "boolean",
                                            "title": "The required communication has been sent"
                                        }
                                    },
                                    "required": ["issueResolved"]
                                }
                            ]
                        }
                    }
                },
                "uiSchema": {
                    "ui:order": [
                        "issuesList",
                        "details",
                        "yesDisabled",
                        "issueResolved",
                        "communicationSent",
                        "uploadDocuments",
                        "attachments"
                    ],
                    "ui:globalOptions": {
                        "duplicateKeySuffixSeparator": "_",
                        "orderable": false,
                        "copyable": false
                    },
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },
                            "processingReason": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "processingResolution": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:options": {
                                    "label": false
                                }
                            }
                        }
                    },
                    "details": {
                        "ui:options": {
                            "label": true
                        },
                        "onwerDetails": {
                            "ui:options": {
                                "cardtype": "Detailed",
                                "icon": "CIRCLE_USER",
                                "label": false,
                                "ObjectFieldTemplate": "CardTemplate",
                                "key": "onwerDetails"
                            }
                        },
                        "documentDetails": {
                            "ui:options": {
                                "canAdd": false,
                                "label": false,
                                "cardType": "Document",
                                "icon": "DOCUMENT_TEXT",
                                "ObjectFieldTemplate": "CardTemplate"
                            }
                        }
                    },
                    "yesDisabled": {
                        "ui:options": {
                            "label": true,
                            "ArrayFieldTemplate": "TextListTemplate",
                            "keyName": "reason",
                            "type": "info"
                        }
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "label": false,
                            "inline": true,
                            "enumDisabled": [true]
                        },
                        "ui:hideError": true
                    },
                    "communicationSent": {
                        "ui:options": {
                            "label": true
                        }
                    },
                    "uploadDocuments": {
                        "inline": true,
                        "ui:options": {
                            "label": true,
                            "omitValue": true
                        },
                        "upload": {
                            "ui:widget": "AutoCompleteWidget",
                            "ui:placeholder": "Find existing documents...",
                            "ui:options": {
                                "label": false,
                                "icon": "Search"
                            }
                        },
                        "or": {
                            "ui:options": {
                                "label": false,
                                "inline": true
                            }
                        },
                        "attachment": {
                            "ui:options": {
                                "label": false,
                                "showFiles": false
                            },
                            "ui:props": {
                                "apiUrl": "case/v1/form/metadata?process=Common&taskType=UI_UPLOAD_DOCUMENT&carrier=null",
                                "apiMethod": "get"
                            }
                        }
                    },
                    "attachments": {
                        "ui:options": {
                            "label": false,
                            "addable": false,
                            "removable": true,
                            "ArrayFieldTemplate": "FileInfoTemplate"
                        }
                    }
                }
            }
        ]
    }
}
