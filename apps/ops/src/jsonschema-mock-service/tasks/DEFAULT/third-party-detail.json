                                        "ui:separator": " - "
                                    },
                                    "documentSource": {
                                        "type": "string"
                                    },
                                    "documentExt": { "type": "string" },
                                    "carrier": {
                                        "type": "string",
                                        "default": "{{carrier}}"
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "enum": [true, false],
                            "enumNames": [
                                "The paper application is complete.",
                                "The paper application is incomplete."
                            ],
                            "title": "Is the paper application form complete?",
                            "default": true
                        }
                    },
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": true
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": false
                                        },
                                        "declineReason": {
                                            "type": "array",
                                            "title": "What is the issue with the form?",
