        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Form Review",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "sectionHeader": {
                            "type": "object",
                            "title": "Processing instructions",
                            "description": "As part of the Third Party Designee Change process, the paper form requires digitization through data entry to ensure accurate capture of information for case processing."
                        },
                        "details": {
                            "type": "object",
                            "title": "Document Details",
                            "properties": {
                                "documents": {
                                    "type": "array",
                                    "title": "Supporting document",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "documentId": {
                                                "type": "string",
                                                "ui:field": "subTitle",
                                                "ui:placeholder": "Documemt ID: "
                                            },
                                            "documentType": {
                                                "type": "string",
                                                "ui:field": "title",
                                                "ui:separator": " - "
                                            },
                                            "documentName": {
                                                "type": "string",
                                                "ui:field": "title",
                                                "ui:separator": " - "
                                            },
                                            "documentSource": {
                                                "type": "string"
                                            },
                                            "documentExt": { "type": "string" },
                                            "carrier": {
                                                "type": "string",
                                                "default": "{{carrier}}"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "enum": [true, false],
                            "enumNames": [
                                "The paper application is complete",
                                "The paper application is incomplete"
                            ],
                            "title": "Is the paper application form complete?",
                            "default": true
                        }
                    }
                },
                "uiSchema": {
                    "ui:globalOptions": {
                        "duplicateKeySuffixSeparator": "_",
                        "orderable": false,
                        "copyable": false
                    },
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "sectionHeader": {
                        "ui:options": {
                            "label": true,
                            "ObjectFieldTemplate": "InstructionsTemplate"
                        }
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "label": true
                        },
                        "ui:dataPath": ["issueResolved"],
                        "ui:hideError": true
                    },
                    "details": {
                        "ui:options": {
                            "label": false
                        },
                        "documents": {
                            "props": {
                                "readonly": true
                            },
                            "items": {
                                "ui:options": {
                                    "ObjectFieldTemplate": "CardTemplate",
                                    "cardType": "Document",
                                    "icon": "DOCUMENT_TEXT",
                                    "nobackground": true
                                },
                                "documentId": {
                                    "ui:widget": "text"
                                },
                                "documentName": {
                                    "ui:widget": "text"
                                },
                                "documentSource": {
                                    "ui:widget": "text"
                                },
                                "documentType": {
                                    "ui:widget": "text"
                                }
                            },
                            "ui:options": {
                                "addable": false
                            },
                            "ui:dataPath": ["documents"]
                        },
                        "ui:dataPath": ["details"]
                    }
                }
            },
            {
                "title": "Third Party Designee Form",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "thirdPartyDesignee": {
                            "type": "object",
                            "properties": {
                                "policyInfoHeader": {
                                    "type": "object",
                                    "title": "1. Policy Information"
                                },
                                "policyNumber": {
                                    "type": "string",
                                    "title": "Policy number"
                                },
                                "policyOwner": {
                                    "type": "string",
                                    "title": "Policy owner"
