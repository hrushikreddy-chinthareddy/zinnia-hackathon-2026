                                                "type": "object",
                                                "properties": {
                                                    "value": {
                                                        "type": "string"
                                                    },
                                                    "exceptionSubRefs": {
                                                        "type": "array",
                                                        "minItems": 1,
                                                        "items": {
                                                            "type": "object",
                                                            "additionalProperties": {
                                                                "type": "string"
                                                            }
                                                        }
                                                    }
                                                },
                                                "required": [
                                                    "value",
                                                    "exceptionSubRefs"
                                                ]
                                            },
                                            "minItems": 1
                                        }
                                    }
                                }
                            ]
                        }
                    }
