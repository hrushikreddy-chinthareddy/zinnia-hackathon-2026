                                },
                                "designeeDetailsHeader": {
                                    "type": "object",
                                    "title": "2. Designee Details"
                                },
                                "designeeType": {
                                    "type": "string",
                                    "enum": [
                                        "Individual",
                                        "Trust",
                                        "Organization"
                                    ],
                                    "title": "Designee type"
                                },
                                "prefix": {
                                    "type": "string",
                                    "enum": [
                                        "Mr.",
                                        "Mrs.",
                                        "Ms.",
                                        "Dr.",
                                        "Miss"
                                    ],
                                    "title": "Prefix"
                                },
                                "firstName": {
                                    "type": "string",
                                    "title": "First name"
                                },
                                "middleName": {
                                    "type": "string",
                                    "title": "Middle name"
                                },
                                "lastName": {
                                    "type": "string",
                                    "title": "Last name"
                                },
                                "suffix": {
                                    "type": "string",
                                    "enum": ["I", "II", "III", "Jr", "Sn"],
                                    "title": "Suffix"
                                },
                                "communicationPreference": {
                                    "type": "string",
                                    "enum": ["Address", "Email"],
                                    "title": "Communication preference"
                                },
                                "address": {
                                    "type": "string",
                                    "title": "Address"
                                },
                                "city": {
                                    "type": "string",
                                    "title": "City/Town"
                                },
                                "state": {
                                    "type": "string",
                                    "title": "State"
                                },
                                "zipCode": {
                                    "type": "string",
                                    "title": "Zip code"
                                },
                                "phone": {
                                    "type": "string",
                                    "title": "Phone"
                                },
                                "email": {
                                    "type": "string",
                                    "title": "Email"
                                },
                                "signatureHeader": {
                                    "type": "object",
                                    "title": "3. Signatures"
                                },
                                "signature": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "signType": {
                                                "type": "string",
                                                "title": "Type"
                                            },
                                            "isSignedPresent": {
                                                "type": "string",
                                                "title": "Signature present?",
                                                "enum": ["Yes", "No"]
                                            },
                                            "signDesignation": {
                                                "type": "string",
                                                "title": "Designation",
                                                "enum": [
                                                    "Trustee",
                                                    "Executor",
                                                    "Custodian",
                                                    "Guardian",
                                                    "Attorney-in-fact",
                                                    "Assignee",
                                                    "NA"
                                                ]
                                            },
                                            "signDate": {
                                                "type": ["string", "null"],
                                                "title": "Signature date",
                                                "format": "date",
                                                "default": null
                                            }
                                        }
                                    }
                                }
                            },
                            "allOf": [
                                {
                                    "if": {
                                        "properties": {
                                            "matchDetails": {
                                                "enum": ["No"]
                                            }
                                        }
                                    },
                                    "then": {
                                        "properties": {
                                            "mismatchValue": {
                                                "title": "Mismatch value",
                                                "type": "array",
                                                "uniqueItems": true,
                                                "items": {
                                                    "type": "string",
                                                    "enum": [
                                                        "Owner name",
                                                        "Joint owner name",
                                                        "Insured name"
                                                    ]
                                                }
                                            }
                                        }
                                    },
                                    "else": {
                                        "properties": {}
                                    }
                                }
                            ]
                        }
                    }
