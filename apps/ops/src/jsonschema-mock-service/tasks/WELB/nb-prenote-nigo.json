{
    "formId": "d30857ef-cf3f-46dc-b461-694c5b0e0c19",
    "process": "New Business",
    "taskType": "NB_PRENOTE_NIGO",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "process": "New Business",
                "carrier": "WELB",
                "taskType": "NB_PRENOTE_NIGO",
                "title": "Review Pre-Note Issues",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "processingReason": {
                                        "type": "string",
                                        "title": "Issues"
                                    },
                                    "processingResolution": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },
                        "details": {
                            "type": "object",
                            "title": "Details"
                        },
                        "paymentRecordId": {
                            "type": "string",
                            "title": "Payment record ID"
                        },
                        "ownerDetails": {
                            "type": "object",
                            "title": "Supporting Information",
                            "properties": {
                                "firstName": {
                                    "type": "string",
                                    "title": "First Name",
                                    "ui:field": "title"
                                },
                                "ssn": {
                                    "type": "string",
                                    "title": "SSN",
                                    "ui:field": "subTitle",
                                    "dataType": "ssn"
                                },
                                "lastName": {
                                    "type": "string",
                                    "title": "Last Name",
                                    "ui:field": "title"
                                }
                            }
                        },
                        "documents": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "documentId": {
                                        "type": "string",
                                        "ui:field": "subTitle",
                                        "ui:placeholder": "Documemt ID: "
                                    },
                                    "documentType": {
                                        "type": "string"
                                    },
                                    "documentTypeDescription": {
                                        "type": "string",
                                        "ui:field": "title"
                                    },
                                    "documentSource": {
                                        "type": "string"
                                    },
                                    "documentExt": {
                                        "type": "string"
                                    },
                                    "carrier": {
                                        "type": "string",
                                        "default": "{{carrier}}"
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "enum": [true, false],
                            "enumNames": ["Yes", "No"],
                            "title": "Can you proceed ?"
                        },
                        "attachments": {
                            "type": "array",
                            "title": "Link or upload document",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "documentId": {
                                        "title": "Document Id",
                                        "type": "string"
                                    },
                                    "documentName": {
                                        "title": "Document Name",
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "required": ["deliveryMethod"],
                                    "properties": {
                                        "issueResolved": {
                                            "const": true
                                        },
                                        "surrenderCompanyName": {
                                            "type": "string",
                                            "title": "Surrender carrier name"
                                        },
                                        "surrenderContractNumber": {
                                            "type": "string",
                                            "title": "Surrender carrier contract number"
                                        },
                                        "deliveryMethod": {
                                            "type": "string",
                                            "enum": ["MAIL", "FAX"],
                                            "enumNames": ["Mail", "Fax"],
                                            "title": "LOA Delivery method"
                                        },
                                        "address": {
                                            "type": "object",
                                            "title": "",
                                            "properties": {
                                                "addressLine1": {
                                                    "type": "string",
                                                    "title": "Address"
                                                },
                                                "addressLine2": {
                                                    "type": ["string", "null"],
                                                    "title": "Address 2"
                                                },
                                                "city": {
                                                    "type": "string",
                                                    "title": "City"
                                                },
                                                "state": {
                                                    "type": "string",
                                                    "title": "State",
                                                    "$ref": "#/definitions/stateEnum"
                                                },
                                                "zip": {
                                                    "type": "string",
                                                    "title": "Zip"
                                                },
                                                "zip4": {
                                                    "type": "string",
                                                    "title": "Zip+4"
                                                }
                                            }
                                        },
                                        "deliveryFaxNumber": {
                                            "type": ["string", "null"],
                                            "title": "Fax number"
                                        }
                                    },
                                    "allOf": [
                                        {
                                            "if": {
                                                "properties": {
                                                    "deliveryMethod": {
                                                        "const": "MAIL"
                                                    }
                                                },
                                                "required": ["deliveryMethod"]
                                            },
                                            "then": {
                                                "required": ["address"],
                                                "properties": {
                                                    "address": {
                                                        "type": "object",
                                                        "required": [
                                                            "addressLine1",
                                                            "city",
                                                            "state",
                                                            "zip"
                                                        ],
                                                        "properties": {
                                                            "addressLine1": {
                                                                "type": "string",
                                                                "title": "Address",
                                                                "minLength": 1
                                                            },
                                                            "addressLine2": {
                                                                "type": [
                                                                    "string",
                                                                    "null"
                                                                ],
                                                                "title": "Address 2"
                                                            },
                                                            "city": {
                                                                "type": "string",
                                                                "title": "City",
                                                                "minLength": 1
                                                            },
                                                            "state": {
                                                                "type": "string",
                                                                "title": "State",
                                                                "$ref": "#/definitions/stateEnum",
                                                                "minLength": 1
                                                            },
                                                            "zip": {
                                                                "type": "string",
                                                                "title": "Zip",
                                                                "minLength": 1
                                                            },
                                                            "zip4": {
                                                                "type": "string",
                                                                "title": "Zip+4"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "if": {
                                                "properties": {
                                                    "deliveryMethod": {
                                                        "const": "FAX",
                                                        "minLength": 1
                                                    }
                                                },
                                                "required": ["deliveryMethod"]
                                            },
                                            "then": {
                                                "required": [
                                                    "deliveryFaxNumber"
                                                ]
                                            }
                                        }
                                    ]
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": false
                                        },
                                        "statusReason": {
                                            "type": "object",
                                            "title": "The status reason for the task will be set to:",
                                            "description": "NIGOs unable to be resolved"
                                        },
                                        "communicationSent": {
                                            "type": "boolean",
                                            "title": "The required communication has been sent"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "required": ["issueResolved"],
                    "definitions": {
                        "stateEnum": {
                            "enum": [
                                "AA",
                                "AE",
                                "AK",
                                "AL",
                                "AP",
                                "AR",
                                "AZ",
                                "CA",
                                "CD",
                                "CO",
                                "CT",
                                "DC",
                                "DE",
                                "FL",
                                "FN",
                                "GA",
                                "GU",
                                "HI",
                                "IA",
                                "ID",
                                "IL",
                                "IN",
                                "KS",
                                "KY",
                                "LA",
                                "MA",
                                "MD",
                                "ME",
                                "MI",
                                "MN",
                                "MO",
                                "MS",
                                "MT",
                                "NC",
                                "ND",
                                "NE",
                                "NH",
                                "NJ",
                                "NM",
                                "NV",
                                "NY",
                                "OH",
                                "OK",
                                "OR",
                                "PA",
                                "PR",
                                "RI",
                                "SC",
                                "SD",
                                "TN",
                                "TX",
                                "UT",
                                "VA",
                                "VI",
                                "VT",
                                "WA",
                                "WI",
                                "WV",
                                "WY"
                            ]
                        }
                    }
                },
                "uiSchema": {
                    "ui:order": [
                        "issuesList",
                        "details",
                        "paymentRecordId",
                        "ownerDetails",
                        "documents",
                        "issueResolved",
                        "surrenderCompanyName",
                        "surrenderContractNumber",
                        "deliveryMethod",
                        "address",
                        "deliveryFaxNumber",
                        "statusReason",
                        "communicationSent",
                        "attachments"
                    ],
                    "ui:globalOptions": {
                        "duplicateKeySuffixSeparator": "_",
                        "orderable": false,
                        "copyable": false
                    },
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },
                            "processingReason": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "processingResolution": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:readonly": false,
                                "ui:options": {
                                    "label": false
                                }
                            }
                        },
                        "ui:dataPath": ["issuesList"]
                    },
                    "details": {
                        "ui:options": {
                            "label": true
                        }
                    },
                    "paymentRecordId": {
                        "ui-widget": "ValueWidget",
                        "ui:options": {
                            "label": false,
                            "inline": true,
                            "prefix": ""
                        },
                        "ui:dataPath": [
                            "details",
                            "exchangeReplace",
                            "paymentRecordId"
                        ]
                    },
                    "ownerDetails": {
                        "ui:options": {
                            "cardtype": "Detailed",
                            "icon": "CIRCLE_USER",
                            "label": true,
                            "ObjectFieldTemplate": "CardTemplate",
                            "key": "ownerDetails"
                        },
                        "ui:dataPath": ["details", "ownerDetails"]
                    },
                    "documents": {
                        "props": {
                            "readonly": true
                        },
                        "items": {
                            "ui:options": {
                                "ObjectFieldTemplate": "CardTemplate",
                                "cardType": "Document",
                                "icon": "DOCUMENT_TEXT",
                                "nobackground": true
                            },
                            "documentId": {
                                "ui:widget": "text"
                            },
                            "documentTypeDescription": {
                                "ui:widget": "text"
                            },
                            "documentSource": {
                                "ui:widget": "text"
                            },
                            "documentType": {
                                "ui:widget": "text"
                            },
                            "carrier": {
                                "ui:options": {
                                    "omitValue": true
                                }
                            }
                        },
                        "ui:options": {
                            "addable": false,
                            "label": false
                        },
                        "ui:dataPath": ["details", "documents"]
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "inline": true
                        },
                        "ui:dataPath": ["issueResolved"],
                        "ui:hideError": true
                    },
                    "surrenderCompanyName": {
                        "ui:widget": "text",
                        "ui:dataPath": [
                            "details",
                            "exchangeReplace",
                            "surrenderCompanyName"
                        ]
                    },
                    "surrenderContractNumber": {
                        "ui:widget": "text",
                        "ui:dataPath": [
                            "details",
                            "exchangeReplace",
                            "surrenderContractNumber"
                        ]
                    },
                    "deliveryMethod": {
                        "ui:widget": "radio",
                        "ui:hideError": true,
                        "ui:dataPath": [
                            "details",
                            "exchangeReplace",
                            "deliveryMethod"
                        ]
                    },
                    "address": {
                        "ui:options": {
                            "label": false,
                            "ObjectFieldTemplate": "AddressFieldTemplate"
                        },
                        "addressLine1": {
                            "ui:widget": "text",
                            "ui:options": {
                                "width": 100
                            },
                            "ui:hideError": true
                        },
                        "addressLine2": {
                            "ui:widget": "text",
                            "ui:options": {
                                "width": 100
                            }
                        },
                        "city": {
                            "ui:widget": "text",
                            "ui:options": {
                                "width": 60
                            },
                            "ui:hideError": true
                        },
                        "state": {
                            "ui:widget": "select",
                            "ui:options": {
                                "width": 40
                            },
                            "ui:hideError": true
                        },
                        "zip": {
                            "ui:widget": "text",
                            "ui:options": {
                                "width": 25
                            },
                            "ui:hideError": true
                        },
                        "zip4": {
                            "ui:widget": "text",
                            "ui:options": {
                                "width": 25
                            },
                            "ui:hideError": true
                        },
                        "ui:dataPath": ["details", "exchangeReplace", "address"]
                    },
                    "deliveryFaxNumber": {
                        "ui:widget": "text",
                        "ui:options": {
                            "label": true,
                            "width": 100
                        },
                        "ui:dataPath": [
                            "details",
                            "exchangeReplace",
                            "deliveryFaxNumber"
                        ],
                        "ui:hideError": true
                    },
                    "attachments": {
                        "ui:dataPath": ["attachments"],
                        "inline": true,
                        "ui:widget": "AttachmentWidget",
                        "ui:options": {
                            "label": true
                        }
                    },
                    "statusReason": {
                        "ui:options": {
                            "label": true,
                            "ObjectFieldTemplate": "InstructionsTemplate"
                        }
                    },
                    "communicationSent": {
                        "ui:options": {
                            "widget": "CheckboxWidget",
                            "label": true
                        },
                        "ui:dataPath": [
                            "details",
                            "exchangeReplace",
                            "communicationSent"
                        ]
                    }
                }
            }
        ]
    }
}
