                            "enum": [true, false]
                        },
                        "uploadDocuments": {
                            "type": "object",
                            "title": "Link or upload document",
                            "properties": {
                                "upload": {
                                    "type": "string"
                                },
                                "or": {
                                    "type": "string",
                                    "title": "or"
                                },
                                "attachment": {
                                    "type": "array",
                                    "title": "upload",
                                    "items": {
                                        "title": "upload",
                                        "type": "string",
                                        "format": "data-url"
                                    }
                                }
                            }
                        },
                        "attachments": {
                            "type": "array",
                            "items": {
                                "documentName": {
                                    "title": "Name",
                                    "type": "string"
                                },
                                "documentId": {
                                    "title": "Document Id",
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "enum": [true]
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "enum": [false]
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "required": ["issueResolved"]
                },
                "uiSchema": {
                    "ui:order": ["issuesList", "issueResolved", "uploadDocuments", "attachments"],
                    "ui:globalOptions": {
                        "duplicateKeySuffixSeparator": "_",
                        "orderable": false,
                        "copyable": false
                    },
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },
                            "processingReason": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "processingInstruction": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:options": {
                                    "label": false
                                }
                            }
                        }
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "label": true,
                            "inline": true
                        },
                        "ui:hideError": true
                    },
                    "uploadDocuments": {
                        "inline": true,
                        "ui:options": {
                            "label": true
                        },
                        "upload": {
                            "ui:widget": "AutoCompleteWidget",
                            "ui:placeholder": "Find existing documents...",
                            "ui:options": {
                                "label": false,
                                "icon": "Search"
                            }
                        },
                        "or": {
                            "ui:options": {
                                "label": false,
                                "inline": true
                            }
                        },
                        "attachment": {
                            "ui:options": {
                                "label": false,
                                "showFiles": false
                            },
                            "ui:props": {
                                "apiUrl": "case/v1/form/metadata?process=Common&taskType=UI_UPLOAD_DOCUMENT&carrier=null",
                                "apiMethod": "get"
                            }
                        }
                    },
                    "attachments": {
                        "ui:options": {
                            "label": false,
                            "addable": false,
                            "removable": true,
                            "ArrayFieldTemplate": "FileInfoTemplate"
