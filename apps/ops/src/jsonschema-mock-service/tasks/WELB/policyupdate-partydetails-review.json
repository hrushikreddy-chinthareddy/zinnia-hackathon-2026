{
    "formId": "3e15f22d-940f-4a00-afc4-5fa37c8c3249",
    "process": "Policy Update",
    "taskType": "POLICYUPDATE_PARTYDETAILS_REVIEW",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "SEND NIGO COMMUNICATION",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "processingReason": {
                                        "type": "string",
                                        "title": "Issues",
                                        "default": ""
                                    },
                                    "processingInstruction": {
                                        "type": "string",
                                        "title": "Processing Instructions",
                                        "default": ""
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
