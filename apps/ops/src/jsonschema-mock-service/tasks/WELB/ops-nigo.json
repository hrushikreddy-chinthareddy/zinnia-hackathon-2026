{
    "formId": "c6443de1-8a08-4ebd-a785-9b3870489625",
    "process": "Operations Review",
    "carrier": "WELB",
    "taskType": "OPS_NIGO",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Operation Review NIGO",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "reason": {
                                        "type": "string",
                                        "title": "Issues"
                                    },
                                    "detailedReason": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },
                        "details": {
                            "type": "object",
                            "properties": {
                                "documents": {
                                    "type": "array",
                                    "title": "Supporting Information",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "documentId": {
                                                "type": "string",
                                                "ui:field": "subTitle",
                                                "ui:placeholder": "Documemt ID: "
                                            },
                                            "documentType": {
                                                "type": "string"
                                            },
                                            "documentName": {
                                                "type": "string",
                                                "ui:field": "title"
                                            },
                                            "documentSource": {
                                                "type": "string"
                                            },
                                            "documentExt": {
                                                "type": "string"
                                            },
                                            "carrier": {
                                                "type": "string",
                                                "default": "{{carrier}}"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "title": "Can you resolve the issue?",
                            "enum": [true, false],
                            "enumNames": ["Yes", "No"]
                        },
                        "uploadDocuments": {
                            "type": "object",
                            "title": "Link or upload document",
                            "properties": {
                                "upload": {
                                    "type": "string"
                                },
                                "or": {
                                    "type": "string",
                                    "title": "or"
                                },
                                "attachment": {
                                    "type": "array",
                                    "title": "Upload",
                                    "items": {
                                        "title": "Upload",
                                        "type": "string",
                                        "format": "data-url"
                                    }
                                }
                            }
                        },
                        "attachments": {
                            "type": "array",
                            "items": {
                                "documentName": {
                                    "title": "Name",
                                    "type": "string"
                                },
                                "documentId": {
                                    "title": "Document Id",
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": true
                                        },
                                        "issueResolvedWarning": {
                                            "type": "array",
                                            "title": "",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "reason": {
                                                        "type": "string"
                                                    }
                                                }
                                            },
                                            "default": [
                                                {
                                                    "reason": "Please mark all the listed issues as resolved to proceed."
                                                }
                                            ]
                                        },
                                        "issuesList": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "resolved": {
                                                        "enum": [true]
                                                    }
                                                },
                                                "required": ["resolved"]
                                            }
                                        }
                                    },
                                    "required": ["issuesList"]
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": false
                                        },
                                        "notes": {
                                            "type": "string",
                                            "title": "Please provide details explaining why the issue(s) cannot be resolved",
                                            "minLength": 1
                                        }
                                    },
                                    "required": ["notes"]
                                }
                            ]
                        }
                    },
                    "definitions": {
                        "declineReason": {
                            "enum": ["DEFAULT"]
                        }
                    },
                    "required": ["issueResolved"]
                },
                "uiSchema": {
                    "ui:order": [
                        "issuesList",
                        "details",
                        "issueResolved",
                        "issueResolvedWarning",
                        "notes",
                        "uploadDocuments",
                        "attachments"
                    ],
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },
                            "reason": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "detailedReason": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:readonly": false,
                                "ui:options": {
                                    "label": false
                                },
                                "ui:hideError": true
                            }
                        }
                    },

                    "details": {
                        "ui:options": {
                            "label": false
                        },
                        "documents": {
                            "ui:options": {
                                "label": true,
                                "addable": false
                            },
                            "items": {
                                "ui:options": {
                                    "ObjectFieldTemplate": "CardTemplate",
                                    "cardType": "Document",
                                    "icon": "DOCUMENT_TEXT",
                                    "nobackground": true
                                }
                            }
                        }
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "inline": true
                        },
                        "ui:hideError": true
                    },

                    "notes": {
                        "ui:widget": "textarea",
                        "ui:options": {
                            "label": true
                        },
                        "ui:hideError": true
                    },
                    "issueResolvedWarning": {
                        "ui:options": {
                            "label": false,
                            "ArrayFieldTemplate": "TextListTemplate",
                            "keyName": "reason",
                            "type": "info",
                            "omitValue": true
                        }
                    },
                    "uploadDocuments": {
                        "inline": true,
                        "ui:options": {
                            "label": true,
                            "omitValue": true
                        },
                        "upload": {
                            "ui:widget": "AutoCompleteWidget",
                            "ui:placeholder": "Find existing documents...",
                            "ui:options": {
                                "label": false,
                                "icon": "Search"
                            }
                        },
                        "or": {
                            "ui:options": {
                                "label": false,
                                "inline": true
                            }
                        },
                        "attachment": {
                            "ui:options": {
                                "label": false,
                                "showFiles": false
                            },
                            "ui:props": {
                                "apiUrl": "case/v1/form/metadata?process=Common&taskType=UI_UPLOAD_DOCUMENT&carrier=null",
                                "apiMethod": "get"
                            }
                        }
                    },
                    "attachments": {
                        "ui:options": {
                            "label": false,
                            "addable": false,
                            "removable": true,
                            "ArrayFieldTemplate": "FileInfoTemplate"
                        }
                    }
                }
            }
        ]
    }
}
