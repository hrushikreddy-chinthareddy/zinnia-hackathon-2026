{
    "formId": "a4989f42-afa1-4301-b921-4320ba971fc3",
    "process": "Agent Onboarding",
    "taskType": "AGENT_ONBOARDING_REVIEW",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Validate Onboarding Issues",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "processingInstruction": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },
                        "details": {
                            "type": "object",
                            "title": "Supporting Information",
                            "properties": {
                                "agentDetails": {
                                    "type": "object",
                                    "properties": {
                                        "firstName": {
                                            "type": "string",
                                            "title": "First Name",
                                            "ui:field": "title"
                                        },
                                        "agentNPN": {
                                            "type": "string",
                                            "title": "NPN",
                                            "ui:field": "subTitle"
                                        },
                                        "lastName": {
                                            "type": "string",
                                            "title": "Last Name",
                                            "ui:field": "title"
                                        }
                                    }
                                }
                            }
                        },
                        "issuesResolved": {
                            "type": "string",
                            "title": "Can you resolve the issues?",
                            "enumNames": [
                                "Yes, I can proceed to the next step",
                                "No, there are one or more issues that need to be logged",
                                "Agent already exist in system of record"
                            ],
                            "enum": ["true", "false", "cancelled"]
                        },
                        "attachments": {
                            "type": "array",
                            "title": "Link or upload document",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "documentId": {
                                        "title": "Document Id",
                                        "type": "string"
                                    },
                                    "documentName": {
                                        "title": "Document Name",
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "dependencies": {
                        "issuesResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issuesResolved": {
                                            "enum": ["true"]
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issuesResolved": {
                                            "enum": ["false"]
                                        },
                                        "declineReason": {
                                            "title": "Reason for decline",
                                            "type": "array",
                                            "uniqueItems": true,
                                            "items": {
                                                "$ref": "#/definitions/declineReason"
                                            }
                                        },
                                        "reviewFailureReasonDisplay": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "title": "These issues will be created for the case:"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "definitions": {
                        "declineReason": {
                            "enum": ["DEFAULT"]
                        }
                    },
                    "required": ["issuesResolved"]
                },
                "uiSchema": {
                    "ui:order": [
                        "issuesList",
                        "details",
                        "issuesResolved",
                        "declineReason",
                        "reviewFailureReasonDisplay",
                        "attachments"
                    ],
                    "ui:globalOptions": {
                        "duplicateKeySuffixSeparator": "_",
                        "orderable": false,
                        "copyable": false
                    },
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },

                            "processingInstruction": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:readonly": false,
                                "ui:options": {
                                    "label": false
                                }
                            }
                        }
                    },
                    "attachments": {
                        "inline": true,
                        "ui:widget": "AttachmentWidget",
                        "ui:options": {
                            "label": true
                        }
                    },
                    "details": {
                        "ui:options": {
                            "label": true
                        },
                        "agentDetails": {
                            "ui:options": {
                                "cardtype": "Detailed",
                                "icon": "CIRCLE_USER",
                                "label": false,
                                "ObjectFieldTemplate": "CardTemplate",
                                "key": "agentDetails"
                            }
                        }
                    },
                    "issuesResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "label": true,
                            "inline": true
                        },
                        "ui:hideError": true
                    },
                    "declineReason": {
                        "ui:widget": "select",
                        "ui:options": {
                            "label": false,
                            "enumOptions": [
                                {
                                    "label": "Default",
                                    "value": "DEFAULT"
                                }
                            ]
                        },
                        "items": {
                            "ui:options": {
                                "label": "false"
                            }
                        },
                        "ui:placeholder": "Select Issues"
                    },
                    "reviewFailureReasonDisplay": {
                        "ui:options": {
                            "label": true,
                            "ArrayFieldTemplate": "TextListTemplate",
                            "hasBg": true,
                            "formContext": {
                                "keyName": "customData",
                                "listName": "declineReason",
                                "parseKey": "detailedReason"
                            },
                            "omitValue": true
                        }
                    }
                }
            }
        ]
    }
}
