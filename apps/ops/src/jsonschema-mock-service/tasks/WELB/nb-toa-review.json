{
    "formId": "500468fd-c5e1-4b20-9832-267a355d3d5d",
    "process": "New Business",
    "taskType": "NB_TOA_REVIEW",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "process": "New Business",
                "carrier": "WELB",
                "taskType": "NB_TOA_REVIEW",
                "title": "Review Transfer Issues",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "Issues List",
                                "properties": {
                                    "processingResolution": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },
                        "ownerDetails": {
                            "type": "object",
                            "title": "Supporting Information",
                            "properties": {
                                "firstName": {
                                    "type": "string",
                                    "title": "First Name",
                                    "ui:field": "title"
                                },
                                "ssn": {
                                    "type": "string",
                                    "title": "SSN",
                                    "ui:field": "subTitle",
                                    "dataType": "ssn"
                                },
                                "lastName": {
                                    "type": "string",
                                    "title": "Last Name",
                                    "ui:field": "title"
                                }
                            }
                        },
                        "documents": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "documentId": {
                                        "type": "string",
                                        "ui:field": "subTitle",
                                        "ui:placeholder": "Documemt ID: "
                                    },
                                    "documentType": {
                                        "type": "string"
                                    },
                                    "documentTypeDescription": {
                                        "type": ["string", "null"],
                                        "ui:field": "title"
                                    },
                                    "documentSource": {
                                        "type": "string"
                                    },
                                    "documentExt": {
                                        "type": "string"
                                    },
                                    "carrier": {
                                        "type": "string",
                                        "default": "{{carrier}}"
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "enum": [true, false],
                            "enumNames": ["Yes", "No"],
                            "title": "Can you proceed?"
                        },
                        "attachments": {
                            "type": "array",
                            "title": "Link or upload document",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "documentId": {
                                        "title": "Document Id",
                                        "type": "string"
                                    },
                                    "documentName": {
                                        "title": "Document Name",
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": true
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": false
                                        },
                                        "declineReason": {
                                            "title": "Reason for decline",
                                            "type": "array",
                                            "uniqueItems": true,
                                            "items": {
                                                "$ref": "#/definitions/declineReason"
                                            }
                                        },
                                        "reviewFailureReasonDisplay": {
                                            "type": "array",
                                            "title": "These issues will be created for the case:",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "definitions": {
                        "declineReason": {
                            "enum": ["DEFAULT"]
                        }
                    },
                    "required": ["issueResolved"]
                },
                "uiSchema": {
                    "ui:order": [
                        "issuesList",
                        "ownerDetails",
                        "documents",
                        "issueResolved",
                        "declineReason",
                        "reviewFailureReasonDisplay",
                        "attachments"
                    ],
                    "ui:globalOptions": {
                        "duplicateKeySuffixSeparator": "_",
                        "orderable": false,
                        "copyable": false
                    },
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": true
                        },
                        "ui:dataPath": ["issuesList"],
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },
                            "processingResolution": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:readonly": false,
                                "ui:options": {
                                    "label": false
                                }
                            }
                        }
                    },
                    "ownerDetails": {
                        "ui:options": {
                            "cardtype": "Detailed",
                            "icon": "CIRCLE_USER",
                            "label": true,
                            "ObjectFieldTemplate": "CardTemplate",
                            "key": "ownerDetails"
                        },
                        "ui:dataPath": ["details", "ownerDetails"]
                    },
                    "documents": {
                        "props": {
                            "readonly": true
                        },
                        "items": {
                            "ui:options": {
                                "ObjectFieldTemplate": "CardTemplate",
                                "cardType": "Document",
                                "icon": "DOCUMENT_TEXT",
                                "nobackground": true
                            },
                            "documentId": {
                                "ui:widget": "text"
                            },
                            "documentTypeDescription": {
                                "ui:widget": "text"
                            },
                            "documentSource": {
                                "ui:widget": "text"
                            },
                            "documentType": {
                                "ui:widget": "text"
                            }
                        },
                        "ui:options": {
                            "addable": false,
                            "label": false
                        },
                        "ui:dataPath": ["details", "documents"]
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "inline": true
                        },
                        "ui:dataPath": ["issueResolved"],
                        "ui:hideError": true
                    },
                    "declineReason": {
                        "ui:widget": "select",
                        "ui:options": {
                            "label": false,
                            "enumOptions": [
                                {
                                    "label": "Default",
                                    "value": "DEFAULT"
                                }
                            ]
                        },
                        "items": {
                            "ui:options": {
                                "label": "false"
                            }
                        },
                        "ui:placeholder": "Select Issues",
                        "ui:dataPath": ["declineReason"]
                    },
                    "reviewFailureReasonDisplay": {
                        "ui:options": {
                            "label": true,
                            "ArrayFieldTemplate": "TextListTemplate",
                            "hasBg": true,
                            "formContext": {
                                "keyName": "customData",
                                "listName": "declineReason",
                                "parseKey": "detailedReason"
                            },
                            "omitValue": true
                        }
                    },
                    "attachments": {
                        "ui:dataPath": ["attachments"],
                        "inline": true,
                        "ui:widget": "AttachmentWidget",
                        "ui:options": {
                            "label": true
                        }
                    }
                }
            }
        ]
    }
}
