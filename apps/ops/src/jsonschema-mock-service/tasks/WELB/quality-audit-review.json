{
    "formId": "f84f074f-1a78-4ac3-a341-0bf58ff339e0",
    "process": "Quality Audit",
    "taskType": "QUALITY_AUDIT_REVIEW",
    "taskName": "Quality Audit Review",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Review Quality Audit",
                "formSchema": {
                    "type": "object",
                    "definitions": {
                        "processorDetails": {
                            "enum": [{ "name": "DEFAULT", "partyId": "" }]
                        }
                    },
                    "properties": {
                        "sectionHeader": {
                            "type": "object",
                            "title": "Processing Instructions",
                            "description": "Review the case and supporting information and determine what requires rework. Select the category and provide comments if the case requires rework."
                        },

                        "details": {
                            "type": "object",
                            "title": "Supporting Information",
                            "properties": {
                                "documents": {
                                    "title": "Supporting Information",
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "documentName": {
                                                "type": "string",
                                                "ui:field": "title"
                                            },
                                            "documentId": {
                                                "type": "string",
                                                "ui:field": "subTitle",
                                                "ui:placeholder": "Document ID: "
                                            },
                                            "documentType": {
                                                "type": "string"
                                            },
                                            "documentExt": {
                                                "type": "string"
                                            },
                                            "documentSource": {
                                                "type": "string"
                                            },
                                            "carrier": {
                                                "type": "string",
                                                "default": "{{carrier}}"
                                            },
                                            "docCategory": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "reworkRequired": {
                            "type": "boolean",
                            "title": "Does the case require rework?",
                            "enumNames": [
                                "Yes, subsequent rework is required.",
                                "No, quality audit is passed."
                            ],
                            "enum": [true, false]
                        }
                    },
                    "required": ["reworkRequired"],
                    "if": {
                        "properties": {
                            "reworkRequired": { "const": true }
                        },
                        "required": ["reworkRequired"]
                    },
                    "then": {
                        "properties": {
                            "auditDetails": {
                                "type": "array",
                                "title": "Which process requires rework?",
                                "minItems": 1,
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "processName",
                                        "category",
                                        "subCategory"
                                    ],
                                    "properties": {
                                        "processName": {
                                            "type": "string",
                                            "title": "Process name",
                                            "enum": [
                                                "Agent Validation",
                                                "Attachment Validation",
                                                "NB Application",
                                                "NB Application Validation",
                                                "OFAC",
                                                "Payment Processing",
                                                "Pre Notification",
                                                "Suitability",
                                                "TOA",
                                                "Other"
                                            ]
                                        },
                                        "category": {
                                            "type": "string",
                                            "title": "Category",
                                            "enum": [
                                                "Data entry incorrect",
                                                "Follow-up handled incorrectly",
                                                "Manual review work incorrect",
                                                "NIGO resolution incorrect",
                                                "System Issue",
                                                "Other"
                                            ]
                                        },
                                        "subCategory": {
                                            "type": "string",
                                            "title": "Sub-category",
                                            "enum": [
                                                "Additional document/process requirements complete & IGO - POA/ Trust/ Tax Forms/Waivers/CSLN/GIACT/ FraudShare/Payment Calculations/ Letter of Acceptance/ Corp Resolution/Audit Trail etc.",
                                                "Additional requirements completed - Trust / POA paperwork / Quotes / Annuity option / Exclusion amount, if applicable",
                                                "Address Cascade option was not selected for updating/changing address",
                                                "Address was not verified in USPS.com",
                                                "All NIGOs were not caught",
                                                "All relevant roles were not added",
                                                "All required paperwork received and IGO",
                                                "Appropriate approval is not received",
                                                "Appropriate task is not introduced for a resolution",
                                                "Bene role is not updated to match Owner role - ex. If Jt Owner added",
                                                "Changes based on product/qual type restrictions are not followed - ex. Annuitant can only be changed on NQ",
                                                "Changes due to Divorce - ensure Divorce documentation is sufficient and Community Property rules are met",
                                                "Confirmation Letters and Correspondence sent",
                                                "Contract status not updated correctly",
                                                "Cost basis information is not updated",
                                                "Cost basis information is not updated correctly",
                                                "Cost basis letter need to send",
                                                "Day 2 task not created",
                                                "Delay due to doc pended incorrectly",
                                                "Delay of 1 business day or more from when paperwork was received IGO to when it was actioned",
                                                "Effective Date of Roles is incorrect",
                                                "Exchange / Replacement not created",
                                                "Federal tax withholding option is not correctly coded",
                                                "Follow up process not followed correctly",
                                                "Follow-up process not followed",
                                                "Fund allocation review required",
                                                "IGO but not paid or payment delayed",
                                                "Import Missing - (Any applicable Calculator etc.)",
                                                "Incorrect DOB coded for Owner / Annuitant / Joint Owner / Beneficiary",
                                                "Incorrect Issue date / Policy date / Submit date is taken",
                                                "Incorrect distribution code is taken",
                                                "Incorrect issue state is taken",
                                                "Incorrect premium payment is applied",
                                                "More than 5 Bene Roles are created",
                                                "Multi indexing not done",
                                                "Need supporting documentation to confirm changes/updates",
                                                "Need to update the state withholdings with active SSW on Address Change",
                                                "NIGO Letter not sent",
                                                "NIGO process not followed",
                                                "NIGO process not followed correctly",
                                                "NIGO'd incorrectly",
                                                "OFAC validation not done",
                                                "POA documentation need to send for legal review",
                                                "Payment Details (Banking Info, Address,etc) incorrectly coded",
                                                "Payment Method",
                                                "Pre-notification letter not sent",
                                                "Qualification plan type is incorrect",
                                                "Received form version is not accepted",
                                                "Remove the Rider",
                                                "Replacement box ticked",
                                                "Role info not coded completely and accurately - spelling, address, SSN/Tax ID, relationship, percentage",
                                                "Roles coded incorrectly, including name, address, SSN, percentages",
                                                "Roles not added",
                                                "Source of funds is not correct",
                                                "Special programs not updated correctly",
                                                "State tax withholding option is not correctly coded",
                                                "Suitability process needs to be followed",
                                                "Tax year incorrectly coded",
                                                "Transfer paperwork missing",
                                                "Verify agent is IGO"
                                            ]
                                        },
                                        "auditData": {
                                            "minItems": 1,
                                            "type": "array",
                                            "title": "Audit Data",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "title": "Audit ID"
                                                    },
                                                    "note": {
                                                        "title": "Notes",
                                                        "type": "string",
                                                        "minLength": 1
                                                    },
                                                    "attachments": {
                                                        "type": "array",
                                                        "title": "Link or upload document",
                                                        "items": {
                                                            "type": "object",
                                                            "properties": {
                                                                "documentId": {
                                                                    "title": "Document Id",
                                                                    "type": "string"
                                                                },
                                                                "documentName": {
                                                                    "title": "Document Name",
                                                                    "type": "string"
                                                                }
                                                            }
                                                        }
                                                    }
                                                },
                                                "required": ["id", "note"]
                                            }
                                        }
                                    },
                                    "if": {
                                        "properties": {
                                            "processName": {
                                                "minLength": 1
                                            },
                                            "category": {
                                                "minLength": 1
                                            },
                                            "subCategory": {
                                                "minLength": 1
                                            }
                                        },
                                        "required": [
                                            "processName",
                                            "category",
                                            "subCategory"
                                        ]
                                    },
                                    "then": {
                                        "properties": {
                                            "processorDetails": {
                                                "title": "Processor name",
                                                "$ref": "#/definitions/processorDetails",
                                                "minLength": 1
                                            },
                                            "errorSystem": {
                                                "type": "string",
                                                "title": "Source Application Error"
                                            },
                                            "negligibleError": {
                                                "type": "boolean",
                                                "default": false,
                                                "title": "Log Negligible error"
                                            }
                                        },

                                        "required": [
                                            "processorDetails",
                                            "auditData"
                                        ]
                                    }
                                }
                            }
                        },
                        "required": ["auditDetails"]
                    }
                },
                "uiSchema": {
                    "ui:order": [
                        "sectionHeader",
                        "details",
                        "reworkRequired",
                        "auditDetails"
                    ],
                    "ui:globalOptions": {
                        "duplicateKeySuffixSeparator": "_",
                        "orderable": false,
                        "copyable": false
                    },
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "sectionHeader": {
                        "ui:options": {
                            "ObjectFieldTemplate": "InstructionsTemplate"
                        }
                    },
                    "details": {
                        "ui:options": {
                            "label": true
                        },
                        "documents": {
                            "ui:readonly": true,
                            "ui:options": {
                                "label": false,
                                "addable": false
                            },
                            "items": {
                                "ui:options": {
                                    "cardType": "Document",
                                    "icon": "DOCUMENT_TEXT",
                                    "ObjectFieldTemplate": "CardTemplate",
                                    "nobackground": true,
                                    "noMargin": true
                                },
                                "carrier": {
                                    "ui:options": {
                                        "omitValue": true
                                    }
                                }
                            }
                        }
                    },
                    "reworkRequired": {
                        "ui:widget": "radio"
                    },
                    "auditDetails": {
                        "ui:options": {
                            "orderable": false
                        },
                        "items": {
                            "ui:order": [
                                "processName",
                                "category",
                                "subCategory",
                                "processorDetails",
                                "errorSystem",
                                "negligibleError",
                                "auditData"
                            ],
                            "ui:options": {
                                "title": "another process",
                                "label": false,
                                "minItems": 1,
                                "hideError": true
                            },
                            "processName": {
                                "ui:widget": "select",
                                "ui:placeholder": "Select"
                            },
                            "category": {
                                "ui:widget": "select",
                                "ui:placeholder": "Select"
                            },
                            "subCategory": {
                                "ui:widget": "select",
                                "ui:placeholder": "Select"
                            },
                            "processorDetails": {
                                "ui:widget": "select",
                                "ui:placeholder": "Select",
                                "ui:options": {
                                    "enumNames": ["DEFAULT"]
                                }
                            },
                            "auditData": {
                                "ui:options": {
                                    "orderable": false,
                                    "label": false,
                                    "addable": false
                                },
                                "items": {
                                    "ui:options": {
                                        "title": "another auditData",
                                        "label": false,
                                        "minItems": 1,
                                        "hideError": true,
                                        "nobackground": true,
                                        "noMargin": true
                                    },
                                    "note": {
                                        "hideError": true
                                    },
                                    "id": {
                                        "ui:field": "UUIDField",
                                        "ui:hidden": true
                                    },
                                    "attachments": {
                                        "inline": true,
                                        "ui:widget": "AttachmentWidget",
                                        "ui:options": {
                                            "label": true,
                                            "hideError": true
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
}
