{
    "formId": "fd3fd89f-1d33-4645-8deb-28e240251398",
    "process": "New Business",
    "taskType": "NB_APPLICATION_REVIEW",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "formId": "004c97a1-d97c-4faa-9b7f-8ff9105b4c29",
                "process": "New Business",
                "carrier": "WELB",
                "taskType": "NB_Application_REVIEW",
                "title": "Validate Application Details",
                "formSchema": {
                    "type": "object",
                    "required": ["issueResolved"],
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "processingResolution": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },
                        "details": {
                            "type": "object",
                            "title": "Supporting Information",
                            "properties": {
                                "documents": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "documentTypeDescription": {
                                                "type": "string",
                                                "ui:field": "title"
                                            },
                                            "documentId": {
                                                "type": "string",
                                                "ui:field": "subTitle",
                                                "ui:placeholder": "Document ID: "
                                            },
                                            "documentType": {
                                                "type": "string"
                                            },
                                            "documentExt": {
                                                "type": "string"
                                            },
                                            "carrier": {
                                                "type": "string",
                                                "default": "{{carrier}}"
                                            }
                                        }
                                    }
                                },
                                "ownerDetails": {
                                    "type": "object",
                                    "properties": {
                                        "firstName": {
                                            "title": "First name",
                                            "type": "string",
                                            "ui:field": "title"
                                        },
                                        "lastName": {
                                            "title": "Last name",
                                            "type": "string",
                                            "ui:field": "title"
                                        },
                                        "ssn": {
                                            "type": "string",
                                            "title": "SSN",
                                            "dataType": "ssn",
                                            "ui:field": "subTitle"
                                        }
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "enum": [true, false],
                            "enumNames": [
                                "Yes, I can proceed to the next step.",
                                "No, there are one or more issues to be logged."
                            ],
                            "title": "Can you proceed ?"
                        },
                        "attachments": {
                            "type": "array",
                            "title": "Link or upload document",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "documentId": {
                                        "title": "Document Id",
                                        "type": "string"
                                    },
                                    "documentName": {
                                        "title": "Document Name",
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": true
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": false
                                        },
                                        "declineReason": {
                                            "title": "Reason for decline",
                                            "type": "array",
                                            "uniqueItems": true,
                                            "items": {
                                                "$ref": "#/definitions/declineReason"
                                            }
                                        },
                                        "reviewFailureReasonDisplay": {
                                            "type": "array",
                                            "title": "These issues will be created for the case:",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "definitions": {
                        "declineReason": {
                            "enum": []
                        }
                    }
                },
                "uiSchema": {
                    "ui:order": [
                        "issuesList",
                        "details",
                        "issueResolved",
                        "declineReason",
                        "reviewFailureReasonDisplay",
                        "attachments"
                    ],
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },
                            "processingResolution": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:readonly": false,
                                "ui:options": {
                                    "label": false
                                }
                            }
                        }
                    },
                    "details": {
                        "ui:options": {
                            "label": true
                        },
                        "ownerDetails": {
                            "ui:options": {
                                "cardType": "Detailed",
                                "icon": "CIRCLE_USER",
                                "label": false,
                                "ObjectFieldTemplate": "CardTemplate",
                                "sectionTitle": "Details"
                            }
                        },
                        "documents": {
                            "ui:options": {
                                "canAdd": false,
                                "label": false,
                                "addable": false
                            },
                            "items": {
                                "ui:options": {
                                    "cardType": "Document",
                                    "icon": "DOCUMENT_TEXT",
                                    "ObjectFieldTemplate": "CardTemplate",
                                    "nobackground": true
                                }
                            },
                            "carrier": {
                                "ui:options": {
                                    "omitValue": true
                                }
                            }
                        }
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "inline": true
                        },
                        "ui:hideError": true
                    },
                    "declineReason": {
                        "ui:widget": "select",
                        "ui:options": {
                            "label": false,
                            "enumOptions": [
                                {
                                    "label": "Default",
                                    "value": "DEFAULT"
                                }
                            ]
                        },
                        "ui:placeholder": "Select Issues"
                    },
                    "reviewFailureReasonDisplay": {
                        "ui:options": {
                            "label": true,
                            "ArrayFieldTemplate": "TextListTemplate",
                            "hasBg": true,
                            "formContext": {
                                "keyName": "customData",
                                "listName": "declineReason",
                                "parseKey": "detailedReason"
                            },
                            "omitValue": true
                        }
                    },
                    "attachments": {
                        "inline": true,
                        "ui:widget": "AttachmentWidget",
                        "ui:options": {
                            "label": true
                        }
                    }
                }
            }
        ]
    }
}
