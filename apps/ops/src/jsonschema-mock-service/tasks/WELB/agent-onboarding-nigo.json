{
    "formId": "5eaf1248-2a7e-4ec6-8a01-87e1ac9fb395",
    "process": "Agent Onboarding",
    "taskType": "AGENT_ONBOARDING_NIGO",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Review Onboarding Issues",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "detailedReason": {
                                        "type": "string",
                                        "title": "Issues"
                                    },
                                    "processingInstruction": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },
                        "details": {
                            "type": "object",
                            "title": "Supporting Information",
                            "properties": {
                                "agentDetails": {
                                    "type": "object",
                                    "properties": {
                                        "firstName": {
                                            "type": "string",
                                            "title": "First Name",
                                            "ui:field": "title"
                                        },
                                        "agentNPN": {
                                            "type": "string",
                                            "title": "NPN",
                                            "ui:field": "subTitle"
                                        },
                                        "lastName": {
                                            "type": "string",
                                            "title": "Last Name",
                                            "ui:field": "title"
                                        }
                                    }
                                },
                                "documents": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "documentName": {
                                                "type": "string",
                                                "ui:field": "title"
                                            },
                                            "documentId": {
                                                "type": "string",
                                                "ui:field": "subTitle",
                                                "ui:placeholder": "Document ID: "
                                            },
                                            "documentType": {
                                                "type": "string"
                                            },
                                            "documentExt": {
                                                "type": "string"
                                            },
                                            "carrier": {
                                                "type": "string",
                                                "default": "{{carrier}}"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "issuesResolved": {
                            "title": "Can you resolve the issues?",
                            "enumNames": ["Yes", "No"],
                            "enum": ["true", "false"]
                        },
                        "attachments": {
                            "type": "array",
                            "title": "Link or upload document",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "documentId": {
                                        "title": "Document Id",
                                        "type": "string"
                                    },
                                    "documentName": {
                                        "title": "Document Name",
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "dependencies": {
                        "issuesResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issuesResolved": {
                                            "enum": ["true"]
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issuesResolved": {
                                            "enum": ["false"]
                                        },
                                        "issueReason": {
                                            "type": "object",
                                            "title": "The status reason for the task will be set to:",
                                            "description": "NIGO's unable to be resolved"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "required": ["issuesResolved"]
                },
                "uiSchema": {
                    "ui:order": [
                        "issuesList",
                        "details",
                        "issuesResolved",
                        "declineReason",
                        "issueReason",
                        "attachments"
                    ],
                    "ui:globalOptions": {
                        "duplicateKeySuffixSeparator": "_",
                        "orderable": false,
                        "copyable": false
                    },
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate",
                                "templateType": "table"
                            },
                            "detailedReason": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "processingInstruction": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:readonly": false,
                                "ui:options": {
                                    "label": false
                                }
                            }
                        }
                    },
                    "details": {
                        "ui:options": {
                            "label": true
                        },
                        "agentDetails": {
                            "ui:options": {
                                "cardtype": "Detailed",
                                "icon": "CIRCLE_USER",
                                "label": false,
                                "ObjectFieldTemplate": "CardTemplate",
                                "key": "agentDetails",
                                "sectionTitle": "Details"
                            }
                        },
                        "documents": {
                            "ui:options": {
                                "canAdd": false,
                                "label": false,
                                "addable": false
                            },
                            "items": {
                                "ui:options": {
                                    "cardType": "Document",
                                    "icon": "DOCUMENT_TEXT",
                                    "ObjectFieldTemplate": "CardTemplate",
                                    "nobackground": true
                                }
                            },
                            "carrier": {
                                "ui:options": {
                                    "omitValue": true
                                }
                            }
                        }
                    },
                    "issuesResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "label": true,
                            "inline": true
                        },
                        "ui:hideError": true
                    },
                    "attachments": {
                        "inline": true,
                        "ui:widget": "AttachmentWidget",
                        "ui:options": {
                            "label": true
                        }
                    },

                    "issueReason": {
                        "ui:options": {
                            "label": true,
                            "ObjectFieldTemplate": "InstructionsTemplate"
                        }
                    }
                }
            }
        ]
    }
}
