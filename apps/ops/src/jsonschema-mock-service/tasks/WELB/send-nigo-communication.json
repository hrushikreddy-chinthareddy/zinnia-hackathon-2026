{
    "formId": "3e15f22d-940f-4a00-afc4-5fa37c8c2249",
    "process": "Policy Update",
    "taskType": "SEND_NIGO_COMMUNICATION",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Post Issue NIGO Review",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "rules": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "reason": {
                                        "type": "string",
                                        "title": "Issues",
                                        "default": ""
                                    },
                                    "detailedReason": {
                                        "type": "string",
                                        "title": "Processing Instructions",
                                        "default": ""
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },
                        "process": {
                            "type": "string",
                            "title": "process"
                        }
                    },
                    "default": {
                        "process": ""
                    },
                    "dependencies": {
                        "process": {
                            "if": {
                                "properties": {
                                    "process": {
                                        "const": "Policy Update"
                                    },
                                    "processSubType": {
                                        "const": "Agent Change"
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "communicatedToAgent": {
                                        "type": "boolean",
                                        "title": "Have you communicated the NIGO reason to requester and agent?",
                                        "enumNames": ["Yes", "No"],
                                        "enum": [true, false]
                                    }
                                },
                                "required": ["communicatedToAgent"]
                            },
                            "else": {
                                "properties": {
                                    "issueResolved": {
                                        "type": "boolean",
                                        "title": "Can you resolve the issues?",
                                        "enumNames": ["Yes", "No"],
                                        "enum": [true, false]
                                    }
                                },
                                "dependencies": {
                                    "uploadDocuments": {
                                        "type": "object",
                                        "title": "Link or upload document",
                                        "properties": {
                                            "upload": {
                                                "type": "string"
                                            },
                                            "or": {
                                                "type": "string",
                                                "title": "or"
                                            },
                                            "attachment": {
                                                "type": "array",
                                                "title": "Upload",
                                                "items": {
                                                    "title": "Upload",
                                                    "type": "string",
                                                    "format": "data-url"
                                                }
                                            }
                                        }
                                    },
                                    "attachments": {
                                        "type": "array",
                                        "title": "Link or upload document",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "documentId": {
                                                    "title": "Document Id",
                                                    "type": "string"
                                                },
                                                "documentName": {
                                                    "title": "Document Name",
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    },
                                    "issueResolved": {
                                        "oneOf": [
                                            {
                                                "properties": {
                                                    "issueResolved": {
                                                        "enum": [true]
                                                    }
                                                }
                                            },
                                            {
                                                "properties": {
                                                    "issueResolved": {
                                                        "enum": [false]
                                                    },
                                                    "issueReason": {
                                                        "type": "object",
                                                        "title": "The status reason for the task will be set to:",
                                                        "description": "NIGO's unable to be resolved"
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                },
                                "required": ["issueResolved"]
                            }
                        }
                    }
                },
                "uiSchema": {
                    "ui:order": [
                        "rules",
                        "issueResolved",
                        "declineReason",
                        "issueReason",
                        "communicatedToAgent",
                        "uploadDocuments",
                        "attachments",
                        "process"
                    ],
                    "ui:globalOptions": {
                        "duplicateKeySuffixSeparator": "_",
                        "orderable": false,
                        "copyable": false
                    },
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "rules": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },
                            "detailedReason": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "reason": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:readonly": false,
                                "ui:options": {
                                    "label": false
                                }
                            }
                        }
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "label": true,
                            "inline": true
                        },
                        "ui:hideError": true
                    },
                    "attachments": {
                        "inline": true,
                        "ui:widget": "AttachmentWidget",
                        "ui:options": {
                            "label": true
                        }
                    },
                    "communicatedToAgent": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "label": true,
                            "inline": true
                        }
                    },
                    "issueReason": {
                        "ui:options": {
                            "label": true,
                            "ObjectFieldTemplate": "InstructionsTemplate"
                        }
                    },
                    "process": {
                        "ui:widget": "hidden"
                    }
                }
            }
        ]
    }
}
