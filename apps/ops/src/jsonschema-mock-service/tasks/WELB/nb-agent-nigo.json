{
    "formId": "8f6c435b-9827-430f-b776-dd6101d1cfd3",
    "process": "New Business",
    "carrier": "WELB",
    "taskType": "NB_AGENT_NIGO",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Review Agent Issues",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "processingReason": {
                                        "type": "string",
                                        "title": "Issues"
                                    },
                                    "processingResolution": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },
                        "details": {
                            "type": "object",
                            "title": "Supporting Information",
                            "properties": {
                                "agentDetails": {
                                    "type": "object",
                                    "properties": {
                                        "firstName": {
                                            "type": "string",
                                            "title": "First Name",
                                            "ui:field": "title"
                                        },
                                        "agentExternalId": {
                                            "type": "string",
                                            "title": "External Id",
                                            "ui:field": "subTitle",
                                            "dataType": "ssn"
                                        },
                                        "taxId": {
                                            "type": "string",
                                            "title": "SSN",
                                            "dataType": "ssn"
                                        },
                                        "lastName": {
                                            "type": "string",
                                            "title": "Last Name",
                                            "ui:field": "title"
                                        }
                                    }
                                },
                                "agentDocument": {
                                    "type": "object",
                                    "properties": {
                                        "documentName": {
                                            "type": "string"
                                        },
                                        "documentId": {
                                            "type": "string"
                                        },
                                        "documentSource": {
                                            "type": "string"
                                        },
                                        "createdDate": {
                                            "type": "string"
                                        },
                                        "carrier": {
                                            "type": "string",
                                            "default": "{{carrier}}"
                                        }
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "enumNames": ["Yes", "No"],
                            "enum": [true, false],
                            "title": "Can you resolve the issues?"
                        },
                        "uploadDocuments": {
                            "type": "object",
                            "title": "Link or upload document",
                            "properties": {
                                "upload": {
                                    "type": "string"
                                },
                                "or": {
                                    "type": "string",
                                    "title": "or"
                                },
                                "attachment": {
                                    "type": "array",
                                    "title": "upload",
                                    "items": {
                                        "title": "upload",
                                        "type": "string",
                                        "format": "data-url"
                                    }
                                }
                            }
                        },
                        "attachments": {
                            "type": "array",
                            "items": {
                                "documentName": {
                                    "title": "Name",
                                    "type": "string"
                                },
                                "documentId": {
                                    "title": "Document Id",
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": true
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": false
                                        },
                                        "reason": {
                                            "type": "object",
                                            "title": "The status reason for the task will be set to:",
                                            "description": "NIGO's unable to be resolved"
                                        }
                                    },
                                    "required": ["issueResolved"]
                                }
                            ]
                        }
                    },
                    "required": ["issueResolved"]
                },
                "uiSchema": {
                    "ui:order": ["issuesList", "details", "issueResolved", "declineReason", "reason", "uploadDocuments", "attachments"],
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },
                            "processingReason": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "processingResolution": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:options": {
                                    "label": false
                                }
                            }
                        }
                    },
                    "details": {
                        "ui:options": {
                            "label": true
                        },
                        "agentDetails": {
                            "ui:options": {
                                "cardType": "Detailed",
                                "icon": "CIRCLE_USER",
                                "label": false,
                                "ObjectFieldTemplate": "CardTemplate",
                                "key": "agentDetails",
                                "sectionTitle": "Details"
                            }
                        },
                        "agentDocument": {
                            "ui:options": {
                                "canAdd": false,
                                "label": false,
                                "cardType": "Document",
                                "icon": "DOCUMENT_TEXT",
                                "ObjectFieldTemplate": "CardTemplate"
                            }
                        }
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "inline": true
                        },
                        "ui:hideError": true
                    },
                    "uploadDocuments": {
                        "inline": true,
                        "ui:options": {
                            "label": true,
                            "omitValue": true
                        },
                        "upload": {
                            "ui:widget": "AutoCompleteWidget",
                            "ui:placeholder": "Find existing documents...",
                            "ui:options": {
                                "label": false,
                                "icon": "Search"
                            }
                        },
                        "or": {
                            "ui:options": {
                                "label": false,
                                "inline": true
                            }
                        },
                        "attachment": {
                            "ui:options": {
                                "label": false,
                                "showFiles": false
                            },
                            "ui:props": {
                                "apiUrl": "case/v1/form/metadata?process=Common&taskType=UI_UPLOAD_DOCUMENT&carrier=null",
                                "apiMethod": "get"
                            }
                        }
                    },
                    "attachments": {
                        "ui:options": {
                            "label": false,
                            "addable": false,
                            "removable": true,
                            "ArrayFieldTemplate": "FileInfoTemplate"
                        }
                    },
                    "reason": {
                        "ui:options": {
                            "label": true,
                            "ObjectFieldTemplate": "InstructionsTemplate"
                        }
                    }
                }
            }
        ]
    }
}
