{
    "formId": "34e13114-36e6-47ef-b218-607eecb34f1b",
    "process": "New Business",
    "carrier": "WELB",
    "taskType": "NB_PAYMENT_FOLLOW_UP",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Payment Follow-Up",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "Issues List",
                                "properties": {
                                    "processingResolution": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },
                        "details": {
                            "type": "object",
                            "title": "Supporting Information",
                            "properties": {
                                "documents": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "documentId": {
                                                "type": "string",
                                                "ui:field": "subTitle",
                                                "ui:placeholder": "Documemt ID: "
                                            },
                                            "documentType": {
                                                "type": "string",
                                                "ui:field": "title",
                                                "ui:separator": " - "
                                            },
                                            "documentName": {
                                                "type": "string",
                                                "ui:field": "title",
                                                "ui:separator": " - "
                                            },
                                            "documentSource": {
                                                "type": "string"
                                            },
                                            "documentExt": {
                                                "type": "string"
                                            },
                                            "carrier": {
                                                "type": "string",
                                                "default": "{{carrier}}"
                                            }
                                        }
                                    }
                                },
                                "paymentRecord": {
                                    "type": "object",
                                    "properties": {
                                        "companyName": {
                                            "type": "string",
                                            "title": "Surrendering carrier name",
                                            "default": "{{payment.exchangeReplace.companyName}}",
                                            "ui:field": "title"
                                        },
                                        "sourcePolicyNumber": {
                                            "type": "string",
                                            "title": "Surrendering carrier contract number",
                                            "default": "{{payment.exchangeReplace.sourcePolicyNumber}}"
                                        },
                                        "address": {
                                            "type": "string",
                                            "title": "Address",
                                            "default": "{{payment.exchangeReplace.address}}",
                                            "dataType": "dirtyAddress"
                                        },
                                        "grossAmount": {
                                            "type": "string",
                                            "title": "Gross Amount",
                                            "default": "{{payment.grossAmount}}",
                                            "dataType": "amount"
                                        },
                                        "netAmount": {
                                            "type": "string",
                                            "title": "Net Amount",
                                            "default": "{{payment.netAmount}}",
                                            "dataType": "amount"
                                        },
                                        "transferAmount": {
                                            "type": "string",
                                            "title": "Expected transfer amount",
                                            "default": "{{payment.exchangeReplace.amountRequested}}",
                                            "ui:field": "subTitle",
                                            "dataType": "amount"
                                        },
                                        "paymentStatus": {
                                            "type": "string",
                                            "title": "Payment Status",
                                            "default": "{{paymentRecordStatus}}"
                                        }
                                    }
                                }
                            }
                        },
                        "rejectApplication": {
                            "type": "boolean",
                            "title": "Reject Application",
                            "default": false
                        },
                        "uploadRequired": {
                            "type": "boolean",
                            "default": true
                        }
                    },
                    "dependencies": {
                        "uploadRequired": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "uploadRequired": {
                                            "const": true
                                        },
                                        "uploadDocuments": {
                                            "type": "object",
                                            "title": "Link or upload document",
                                            "properties": {
                                                "upload": {
                                                    "type": "string"
                                                },
                                                "or": {
                                                    "type": "string",
                                                    "title": "or"
                                                },
                                                "attachment": {
                                                    "type": "array",
                                                    "title": "Upload",
                                                    "items": {
                                                        "title": "Upload",
                                                        "type": "string",
                                                        "format": "data-url"
                                                    }
                                                }
                                            }
                                        },
                                        "attachments": {
                                            "type": "array",
                                            "items": {
                                                "documentName": {
                                                    "title": "Name",
                                                    "type": "string"
                                                },
                                                "documentId": {
                                                    "title": "Document Id",
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    },
                                    "required": ["uploadDocuments"]
                                }
                            ]
                        }
                    }
                },
                "uiSchema": {
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },
                            "processingResolution": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:readonly": false,
                                "ui:options": {
                                    "label": false
                                }
                            }
                        }
                    },
                    "details": {
                        "ui:options": {
                            "label": true
                        },
                        "documents": {
                            "items": {
                                "ui:options": {
                                    "ObjectFieldTemplate": "CardTemplate",
                                    "cardType": "Document",
                                    "icon": "DOCUMENT_TEXT",
                                    "nobackground": true
                                },
                                "documentId": {
                                    "ui:widget": "text"
                                },
                                "documentName": {
                                    "ui:widget": "text"
                                },
                                "documentSource": {
                                    "ui:widget": "text"
                                },
                                "documentType": {
                                    "ui:widget": "text"
                                }
                            },
                            "ui:options": {
                                "label": false,
                                "addable": false
                            }
                        },
                        "paymentRecord": {
                            "ui:options": {
                                "canAdd": false,
                                "label": false,
                                "cardType": "Detailed",
                                "icon": "BANK",
                                "ObjectFieldTemplate": "CardTemplate"
                            }
                        }
                    },
                    "rejectApplication": {
                        "ui:options": {
                            "label": true
                        },
                        "ui:hideError": true
                    },
                    "uploadRequired": {
                        "ui:widget": "hidden"
                    },
                    "uploadDocuments": {
                        "inline": true,
                        "ui:options": {
                            "label": true,
                            "omitValue": true
                        },
                        "upload": {
                            "ui:widget": "AutoCompleteWidget",
                            "ui:placeholder": "Find existing documents...",
                            "ui:options": {
                                "label": false,
                                "icon": "Search"
                            }
                        },
                        "or": {
                            "ui:options": {
                                "label": false,
                                "inline": true
                            }
                        },
                        "attachment": {
                            "ui:options": {
                                "label": false,
                                "showFiles": false
                            },
                            "ui:props": {
                                "apiUrl": "case/v1/form/metadata?process=Common&taskType=UI_UPLOAD_DOCUMENT&carrier=null",
                                "apiMethod": "get"
                            }
                        }
                    },
                    "attachments": {
                        "ui:options": {
                            "label": false,
                            "addable": false,
                            "removable": true,
                            "ArrayFieldTemplate": "FileInfoTemplate"
                        }
                    }
                }
            }
        ]
    }
}
