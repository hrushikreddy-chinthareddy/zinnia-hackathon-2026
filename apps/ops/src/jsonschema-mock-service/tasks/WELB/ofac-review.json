{
    "formId": "1ad71c64-0273-4108-b625-83f049c63514",
    "process": "New Business",
    "taskType": "OFAC_REVIEW",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Review OFAC Issues",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "rules": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "issue": {
                                        "type": "string",
                                        "title": "Issues"
                                    },
                                    "rule": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "applicationValue": {
                                        "type": "string",
                                        "title": "Application Information"
                                    },
                                    "nmid": {
                                        "type": "string",
                                        "title": "Additional Info"
                                    },
                                    "externalId": {
                                        "type": "string",
                                        "title": "Additional Info"
                                    }
                                }
                            }
                        },
                        "details": {
                            "type": "object",
                            "properties": {
                                "documents": {
                                    "type": "array",
                                    "title": "Supporting Information",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "documentId": {
                                                "type": "string",
                                                "ui:field": "subTitle",
                                                "ui:placeholder": "Documemt ID: "
                                            },
                                            "documentName": {
                                                "type": "string",
                                                "ui:field": "title"
                                            },
                                            "documentSource": {
                                                "type": "string"
                                            },
                                            "carrier": {
                                                "type": "string",
                                                "default": "{{carrier}}"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "title": "OFAC Decision",
                            "enumNames": ["Accept", "Decline"],
                            "enum": [true, false]
                        },
                        "attachments": {
                            "type": "array",
                            "title": "Link or upload document",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "documentId": {
                                        "title": "Document Id",
                                        "type": "string"
                                    },
                                    "documentName": {
                                        "title": "Document Name",
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "enum": [true]
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "enum": [false]
                                        },
                                        "declineReason": {
                                            "title": "Reason for decline",
                                            "type": "array",
                                            "uniqueItems": true,
                                            "items": {
                                                "$ref": "#/definitions/declineReason"
                                            }
                                        },
                                        "reviewFailureReasonDisplay": {
                                            "type": "array",
                                            "title": "These issues will be created for the case:",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "definitions": {
                        "declineReason": {
                            "enum": ["DEFAULT"]
                        }
                    },
                    "required": ["issueResolved"]
                },
                "uiSchema": {
                    "ui:order": [
                        "rules",
                        "details",
                        "issueResolved",
                        "declineReason",
                        "reviewFailureReasonDisplay",
                        "attachments"
                    ],
                    "ui:globalOptions": {
                        "duplicateKeySuffixSeparator": "_",
                        "orderable": false,
                        "copyable": false
                    },
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "ui:submitButtonOptions": {
                        "norender": true
                    },

                    "details": {
                        "ui:options": {
                            "label": false
                        },
                        "documents": {
                            "props": {
                                "readonly": true
                            },
                            "ui:options": {
                                "label": true,
                                "addable": false
                            },
                            "items": {
                                "ui:options": {
                                    "ObjectFieldTemplate": "CardTemplate",
                                    "cardType": "Document",
                                    "icon": "DOCUMENT_TEXT",
                                    "nobackground": true
                                },
                                "documentId": {
                                    "ui:widget": "text"
                                },
                                "documentName": {
                                    "ui:widget": "text"
                                },
                                "documentSource": {
                                    "ui:widget": "text"
                                },
                                "carrier": {
                                    "ui:options": {
                                        "omitValue": true
                                    }
                                }
                            }
                        }
                    },
                    "rules": {
                        "ui:options": {
                            "label": false,
                            "ArrayFieldTemplate": "ArrayFieldTableTemplate"
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false
                            },
                            "issue": {
                                "ui:placeholder": "Issue",
                                "ui:helpText": "Issue",
                                "ui:options": {
                                    "label": false
                                }
                            },
                            "rule": {
                                "ui:options": {
                                    "label": false
                                }
                            },
                            "applicationInformation": {
                                "ui:options": {
                                    "label": false
                                }
                            },
                            "nmid": {
                                "ui:options": {
                                    "label": false,
                                    "widget": "hidden"
                                }
                            },
                            "externalId": {
                                "ui:options": {
                                    "label": false,
                                    "widget": "hidden"
                                }
                            }
                        }
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "label": true,
                            "inline": true
                        },
                        "ui:hideError": true
                    },
                    "attachments": {
                        "inline": true,
                        "ui:widget": "AttachmentWidget",
                        "ui:options": {
                            "label": true
                        }
                    },
                    "declineReason": {
                        "ui:widget": "select",
                        "ui:options": {
                            "label": false
                        },

                        "ui:placeholder": "Select Issues"
                    },
                    "reviewFailureReasonDisplay": {
                        "ui:options": {
                            "label": true,
                            "ArrayFieldTemplate": "TextListTemplate",
                            "hasBg": true,
                            "formContext": {
                                "keyName": "customData",
                                "listName": "declineReason",
                                "parseKey": "detailedReason"
                            },
                            "omitValue": true
                        }
                    }
                }
            }
        ]
    }
}
