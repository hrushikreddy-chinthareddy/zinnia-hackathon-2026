{
    "formId": "aed4a1af-428d-4467-9fdd-07ecc3f3e239",
    "process": "New Business",
    "taskType": "NB_PAYMENT_PROCESSING_NIGO",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Review Premium Issues",
                "formSchema": {
                    "type": "object",
                    "properties": {
                        "issuesList": {
                            "type": "array",
                            "title": "",
                            "items": {
                                "type": "object",
                                "title": "",
                                "properties": {
                                    "processingReason": {
                                        "type": "string",
                                        "title": "Issues"
                                    },
                                    "processingResolution": {
                                        "type": "string",
                                        "title": "Processing Instructions"
                                    },
                                    "resolved": {
                                        "type": "boolean",
                                        "title": "Resolved"
                                    }
                                }
                            }
                        },

                        "details": {
                            "type": "object",
                            "title": "Supporting Information",
                            "properties": {
                                "paymentRecord": {
                                    "type": "object",
                                    "properties": {
                                        "grossAmount": {
                                            "type": "number",
                                            "title": "Gross Amount"
                                        },
                                        "netAmount": {
                                            "type": "number",
                                            "title": "Net amount"
                                        },
                                        "amountReceived": {
                                            "type": "number",
                                            "title": "Amount Received"
                                        }
                                    }
                                },
                                "ownerDetails": {
                                    "type": "object",
                                    "properties": {
                                        "firstName": {
                                            "type": "string",
                                            "title": "First Name",
                                            "ui:field": "title"
                                        },
                                        "ssn": {
                                            "type": "string",
                                            "title": "SSN",
                                            "ui:field": "subTitle",
                                            "dataType": "ssn"
                                        },
                                        "lastName": {
                                            "type": "string",
                                            "title": "Last Name",
                                            "ui:field": "title"
                                        }
                                    }
                                },
                                "documents": {
                                    "type": "array",
                                    "title": "",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "documentTypeDescription": {
                                                "type": "string",
                                                "ui:field": "title"
                                            },
                                            "documentId": {
                                                "type": "string",
                                                "ui:field": "subTitle",
                                                "ui:placeholder": "Documemt ID: "
                                            },
                                            "documentSource": {
                                                "type": "string"
                                            },
                                            "createdDate": {
                                                "type": "string"
                                            },
                                            "carrier": {
                                                "type": "string",
                                                "default": "{{carrier}}"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "enumNames": ["Yes", "No"],
                            "enum": [true, false],
                            "title": "Can you resolve the issues?"
                        },
                        "attachments": {
                            "type": "array",
                            "title": "Link or upload document",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "documentId": {
                                        "title": "Document Id",
                                        "type": "string"
                                    },
                                    "documentName": {
                                        "title": "Document Name",
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "required": ["issueResolved"],
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": true
                                        },
                                        "effectiveAmount": {
                                            "type": "object",
                                            "title": "Amount to apply",
                                            "properties": {
                                                "grossAmount": {
                                                    "type": "number",
                                                    "title": "Gross Amount"
                                                },
                                                "netAmount": {
                                                    "type": "number",
                                                    "title": "Net amount"
                                                }
                                            }
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": false
                                        },
                                        "reason": {
                                            "type": "object",
                                            "title": "The status reason for the task will be set to:",
                                            "description": "NIGO's unable to be resolved"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                },
                "uiSchema": {
                    "ui:order": [
                        "issuesList",
                        "details",
                        "issueResolved",
                        "effectiveAmount",
                        "reason",
                        "attachments"
                    ],
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "issuesList": {
                        "ui:readonly": true,
                        "ui:options": {
                            "label": false
                        },
                        "items": {
                            "ui:options": {
                                "canAdd": false,
                                "templateType": "table",
                                "ObjectFieldTemplate": "ObjectRowFieldTemplate"
                            },
                            "processingReason": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "processingResolution": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true
                                }
                            },
                            "resolved": {
                                "ui:readonly": false,
                                "ui:options": {
                                    "label": false
                                }
                            }
                        }
                    },

                    "details": {
                        "ui:options": {
                            "label": true
                        },
                        "paymentRecord": {
                            "ui:options": {
                                "label": false
                            },
                            "grossAmount": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true,
                                    "dataType": "amount"
                                }
                            },
                            "netAmount": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true,
                                    "dataType": "amount"
                                }
                            },
                            "amountReceived": {
                                "ui-widget": "ValueWidget",
                                "ui:options": {
                                    "label": false,
                                    "inline": true,
                                    "dataType": "amount"
                                }
                            }
                        },
                        "ownerDetails": {
                            "ui:options": {
                                "cardtype": "Detailed",
                                "icon": "CIRCLE_USER",
                                "label": true,
                                "ObjectFieldTemplate": "CardTemplate",
                                "key": "ownerDetails"
                            }
                        },
                        "documents": {
                            "props": {
                                "readonly": true
                            },
                            "ui:options": {
                                "label": false,
                                "addable": false
                            },
                            "items": {
                                "ui:options": {
                                    "ObjectFieldTemplate": "CardTemplate",
                                    "cardType": "Document",
                                    "icon": "DOCUMENT_TEXT",
                                    "nobackground": true,
                                    "label": false
                                },
                                "documentTypeDescription": {
                                    "ui:widget": "text"
                                },
                                "documentId": {
                                    "ui:widget": "text"
                                },
                                "documentSource": {
                                    "ui:widget": "text"
                                },
                                "carrier": {
                                    "omitValue": true
                                }
                            }
                        }
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "inline": true
                        },
                        "ui:hideError": true
                    },
                    "attachments": {
                        "inline": true,
                        "ui:widget": "AttachmentWidget",
                        "ui:options": {
                            "label": true
                        }
                    },
                    "reason": {
                        "ui:options": {
                            "label": true,
                            "ObjectFieldTemplate": "InstructionsTemplate"
                        }
                    },
                    "effectiveAmount": {
                        "grossAmount": {
                            "ui:options": {
                                "widget": "ValueWidget"
                            }
                        },
                        "netAmount": {
                            "ui:options": {
                                "widget": "ValueWidget"
                            }
                        }
                    }
                }
            }
        ]
    }
}
