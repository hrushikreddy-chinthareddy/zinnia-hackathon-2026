{
    "formId": "fd3fd89f-1d33-4645-8deb-28e240251398",
    "process": "New Business",
    "carrier": "WELB",
    "taskType": "NB_APPLICATION_REVIEW",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "formId": "004c97a1-d97c-4faa-9b7f-8ff9105b4c29",
                "process": "New Business",
                "carrier": "WELB",
                "taskType": "NB_Application_REVIEW",
                "title": "Validate Application Details",
                "formSchema": {
                    "type": "object",
                    "required": ["issueResolved"],
                    "properties": {
                        "sectionHeader": {
                            "type": "object",
                            "title": "Processing Instructions"
                        },
                        "details": {
                            "type": "object",
                            "title": "Details",
                            "properties": {
                                "documentDetails": {
                                    "title": "Supporting Information",
                                    "type": "object",
                                    "properties": {
                                        "documentId": {
                                            "type": "string",
                                            "ui:field": "title"
                                        },
                                        "documentSource": {
                                            "type": "string",
                                            "ui:field": "subTitle"
                                        },
                                        "createdDate": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "onwerDetails": {
                                    "type": "object",
                                    "properties": {
                                        "firstName": {
                                            "title": "First name",
                                            "type": "string",
                                            "ui:field": "title"
                                        },
                                        "lastName": {
                                            "title": "Last name",
                                            "type": "string",
                                            "ui:field": "title"
                                        },
                                        "ssn": {
                                            "type": "string",
                                            "title": "SSN",
                                            "dataType": "ssn",
                                            "ui:field": "subTitle"
                                        }
                                    }
                                }
                            }
                        },
                        "issueResolved": {
                            "type": "boolean",
                            "enum": [
                                true,
                                false
                            ],
                            "enumNames": [
                                "Yes, I can proceed to the next step.",
                                "No, there are one or more issues to be logged."
                            ],
                            "title": "Can you proceed ?"
                        },
                        "uploadDocuments": {
                          "type": "object",
                          "title": "Link or Upload document",
                          "properties": {
                              "upload": {
                                  "type": "string"
                              },
                              "or": {
                                  "type": "string",
                                  "title": "or"
                              },
                              "attachment": {
                                  "type": "array",
                                  "title": "Upload",
                                  "items": {
                                      "title": "Upload",
                                      "type": "string",
                                      "format": "data-url"
                                  }
                              }
                          }
                          },
                          "attachments": {
                              "type": "array",
                              "items": {
                                  "documentName": {
                                      "title": "Name",
                                      "type": "string"
                                  },
                                  "documentId": {
                                      "title": "Document Id",
                                      "type": "string"
                                  }
                              }
                          }
                    },
                    "dependencies": {
                        "issueResolved": {
                            "oneOf": [
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": true
                                        }
                                    }
                                },
                                {
                                    "properties": {
                                        "issueResolved": {
                                            "const": false
                                        },
                                        "declineReason": {
                                            "title": "",
                                            "type": "array",
                                            "uniqueItems": true,
                                            "items": {
                                                "type": "string",
                                                "$ref": "#/definitions/declineReason"
                                            }
                                        },
                                        "reviewFailureReasonDisplay": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "definitions": {
                        "declineReason": {
                            "enum": []
                        }
                    }
                },
                "uiSchema": {
                    "ui:order": ["sectionHeader", "details", "issueResolved", "declineReason", "reviewFailureReasonDisplay", "uploadDocuments", "attachments"],
                    "ui:submitButtonOptions": {
                        "norender": true
                    },
                    "sectionHeader": {
                        "props": {
                            "description": "Review the supporting information and provide an external ID for the Agent."
                        },
                        "ui:options": {
                            "label": true,
                            "ObjectFieldTemplate": "InstructionsTemplate"
                        }
                    },
                    "details": {
                        "ui:options": {
                            "label": false
                        },
                        "onwerDetails": {
                            "ui:options": {
                                "cardType": "Detailed",
                                "icon": "CIRCLE_USER",
                                "label": true,
                                "ObjectFieldTemplate": "CardTemplate",
                                "sectionTitle": "Details"
                            }
                        },
                        "documentDetails": {
                            "props": {
                                "readonly": true
                            },
                            "ui:options": {
                                "canAdd": false,
                                "label": false,
                                "cardType": "Document",
                                "icon": "DOCUMENT_TEXT",
                                "ObjectFieldTemplate": "CardTemplate"
                            }
                        },
                    },
                    "issueResolved": {
                        "ui:widget": "radio",
                        "ui:options": {
                            "inline": true
                        }
                    },
                    "declineReason": {
                        "ui:widget": "select",
                        "ui:options": {
                            "label": false,
                            "enumOptions": [
                                {
                                    "label": "Default",
                                    "value": "DEFAULT"
                                }
                            ]
                        },
                        "ui:placeholder": "Select Issues"
                    },
                    "reviewFailureReasonDisplay": {
                        "ui:options": {
                            "label": false,
                            "ArrayFieldTemplate": "TextListTemplate",
                            "hasBg": true,
                            "textListTitle": "These issues will be created for the case:",
                            "formContext": {
                                "keyName": "customData",
                                "listName": "declineReason"
                            },
                            "omitValue": true
                        }
                    },
                    "uploadDocuments": {
                      "inline": true,
                      "ui:options": {
                          "label": true,
                          "omitValue": true
                      },
                      "upload": {
                          "ui:widget": "AutoCompleteWidget",
                          "ui:placeholder": "Find existing documents...",
                          "ui:options": {
                              "label": false,
                              "icon": "Search"
                          }
                      },
                      "or": {
                          "ui:options": {
                              "label": false,
                              "inline": true
                          }
                      },
                      "attachment": {
                          "ui:options": {
                              "label": false,
                              "showFiles": false
                          },
                          "ui:props": {
                              "apiUrl": "case/v1/form/metadata?process=Common&taskType=UI_UPLOAD_DOCUMENT&carrier=null",
                              "apiMethod": "get"
                          }
                      }
                  },
                  "attachments": {
                      "ui:options": {
                          "label": false,
                          "addable": false,
                          "removable": true,
                          "ArrayFieldTemplate": "FileInfoTemplate"
                      }
                  }

                }
            }
        ]
    }
}