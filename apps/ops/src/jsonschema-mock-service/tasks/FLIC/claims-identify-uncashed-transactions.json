{
    "formId": "95201e9f-8e7a-459c-8b34-e6ebfb8f1390",
    "process": "Claims",
    "carrier": "FLIC",
    "taskType": "CLAIMS_IDENTIFY_UNCASHED_TRANSACTIONS",
    "formSchema": {
        "type": "object"
    },
    "uiSchema": {
        "type": "object"
    },
    "schemaContent": {
        "tabSchemas": [
            {
                "title": "Identify Uncashed Checks",
                "formSchema": {
                    "type": "object",
                    "liveValidate": false,
                    "noValidate": true,
                    "properties": {
                        "sectionHeader": {
                            "type": "object",
                            "title": "Processing Instructions",
                            "description": "Enter details for uncashed transactions against this contract."
                        },
                        "details": {
                            "type": "object",
                            "title": "",
                            "properties": {
                                "uncashTransaction": {
                                    "type": "object",
                                    "title": "",
                                    "properties": {
                                        "uncashTransactionExists": {
                                            "type": "boolean",
                                            "title": "Are there any uncashed transactions against this contract?"
                                        }
                                    },
                                    "allOf": [
                                        {
                                            "if": {
                                                "required": [
                                                    "uncashTransactionExists"
                                                ],
                                                "properties": {
                                                    "uncashTransactionExists": {
                                                        "const": true
                                                    }
                                                }
                                            },
                                            "then": {
                                                "properties": {
                                                    "transactions": {
                                                        "type": "array",
                                                        "title": "Uncashed Transactions",
                                                        "minItems": 1,
                                                        "items": {
                                                            "type": "object",
                                                            "properties": {
                                                                "policyNumber": {
                                                                    "type": "string",
                                                                    "title": "Contract Number",
                                                                    "pattern": "^[0-9]+$",
                                                                    "maxLength": 22
                                                                },
                                                                "transactionNumber": {
                                                                    "type": "string",
                                                                    "title": "Lifecad Transaction ID",
                                                                    "pattern": "^[a-zA-Z0-9]*$",
                                                                    "maxLength": 15
                                                                },
                                                                "transactionDate": {
                                                                    "type": "string",
                                                                    "format": "date",
                                                                    "title": "Check Transaction Date"
                                                                },
                                                                "checkNumber": {
                                                                    "type": "string",
                                                                    "title": "Check Number",
                                                                    "pattern": "^82000[0-9]*$",
                                                                    "maxLength": 20,
                                                                    "dataType": "number"
                                                                },
                                                                "transactionAmount": {
                                                                    "type": "string",
                                                                    "title": "Check Amount",
                                                                    "maxLength": 23,
                                                                    "dataType": "amount"
                                                                }
                                                            },
                                                            "required": [
                                                                "policyNumber",
                                                                "transactionDate",
                                                                "checkNumber",
                                                                "transactionAmount"
                                                            ]
                                                        }
                                                    },
                                                    "additionalNote": {
                                                        "type": "string",
                                                        "title": "Additional Notes"
                                                    }
                                                }
                                            }
                                        }
                                    ],
                                    "required": ["uncashTransactionExists"]
                                },
                                "required": ["uncashTransaction"]
                            }
                        }
                    }
                },
                "uiSchema": {
                    "ui:order": ["sectionHeader", "details"],
                    "ui:submitButtonOptions": {
                        "norender": true,
                        "props": {
                            "noValidate": true
                        }
                    },
                    "ui:options": {
                        "noValidate": true,
                        "showErrors": false,
                        "liveValidate": false
                    },
                    "ui:hideError": false,
                    "sectionHeader": {
                        "ui:options": {
                            "label": true,
                            "ObjectFieldTemplate": "InstructionsTemplate"
                        }
                    },
                    "details": {
                        "uncashTransaction": {
                            "ui:options": {
                                "label": true
                            },
                            "uncashTransactionExists": {
                                "ui:hideError": true,
                                "ui:widget": "radio",
                                "ui:options": {
                                    "enumNames": ["Yes", "No"]
                                }
                            },
                            "transactions": {
                                "ui:options": {
                                    "label": false,
                                    "inline": true,
                                    "orderable": false
                                },
                                "items": {
                                    "inline": true,
                                    "ui:options": {
                                        "label": false,
                                        "title": "transactions",
                                        "minItems": 1,
                                        "centralizedToolbar": true
                                    },
                                    "policyNumber": {
                                        "ui:options": {
                                            "label": true
                                        }
                                    },
                                    "transactionNumber": {
                                        "ui:options": {
                                            "label": true
                                        }
                                    },
                                    "transactionDate": {
                                        "ui:options": {
                                            "label": true,
                                            "format": "MM-DD-YYYY",
                                            "outputFormat": "MM-DD-YYYY"
                                        }
                                    },
                                    "checkNumber": {
                                        "ui:options": {
                                            "label": true
                                        }
                                    },
                                    "transactionAmount": {
                                        "ui:options": {
                                            "label": true,
                                            "widget": "ValueWidget",
                                            "format": "numeric"
                                        }
                                    }
                                }
                            },
                            "additionalNote": {
                                "ui:hideError": true,
                                "ui:widget": "textarea",
                                "type": "string"
                            }
                        }
                    }
                }
            }
        ]
    }
}
