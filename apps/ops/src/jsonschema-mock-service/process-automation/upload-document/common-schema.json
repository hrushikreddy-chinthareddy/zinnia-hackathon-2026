{
    "formId": "84eea90e-e6db-4c7d-806c-e395556a2924",
    "process": "Common",
    "carrier": "null",
    "taskType": "UI_UPLOAD_DOCUMENT",
    "formSchema": {
        "type": "object",
        "definitions": {
            "docCategoryEnum": {},
            "documentTypeEnum": {},
            "formNumberEnum": {}
        },
        "properties": {
            "docCategory": {
                "type": "string",
                "title": "Category",
                "$ref": "#/definitions/docCategoryEnum"
            },
            "documentType": {
                "type": "string",
                "title": "Type",
                "$ref": "#/definitions/documentTypeEnum"
            },
            "formNumberSelect": {
                "type": "string",
                "title": "Form number",
                "$ref": "#/definitions/formNumberEnum"
            },
            "zinniaLiveCaseId": {
                "type": "string",
                "default": "{{customData.caseId}}"
            },
            "correlationId": {
                "type": "string",
                "default": "{{customData.correlationId}}"
            },
            "parentCarrierCode": {
                "type": "string",
                "default": "{{customData.carrier}}"
            },
            "docClassification": {
                "type": "string",
                "default": "INBOUND"
            },
            "docAccessLevel": {
                "type": "string",
                "title": "Restriction",
                "enumNames": ["Restricted", "Un-restricted"],
                "enum": ["CARRIER_ONLY", "CLIENT_COPY"]
            },
            "sourceSystem": {
                "type": "string",
                "default": "ZL"
            }
        },
        "required": ["docCategory", "documentType", "docAccessLevel"]
    },
    "uiSchema": {
        "ui:submitButtonOptions": {
            "props": {
                "disabled": false,
                "className": "btn btn-info"
            },
            "norender": false,
            "submitText": "Upload"
        },
        "options": {
            "ui:label": false,
            "ui:props": {
                "apiUrl": "document/v3/documentType/search?limit=100&offset=0",
                "apiMethod": "post",
                "apiPayload": {
                    "parentCarrierCode": "{{carrier}}"
                },
                "dataKey": "docCategoryEnum",
                "responseType": "schema",
                "responseData": "{{data.documentTypeList}}",
                "response": {
                    "enum": "documentCategoryKey",
                    "enumNames": "documentCategory"
                }
            }
        },
        "zinniaLiveCaseId": {
            "ui:widget": "hidden"
        },
        "correlationId": {
            "ui:widget": "hidden"
        },
        "parentCarrierCode": {
            "ui:widget": "hidden"
        },
        "docClassification": {
            "ui:widget": "hidden"
        },
        "docCategory": {
            "ui:placeholder": "Select a category",
            "ui:props": {
                "apiUrl": "document/v3/documentType/search?limit=100&offset=0",
                "apiMethod": "post",
                "apiPayload": {
                    "parentCarrierCode": "{{customData.carrier}}",
                    "documentCategory": "{{value}}"
                },
                "dataKey": "documentTypeEnum",
                "responseType": "schema",
                "responseData": "{{data.documentTypeList}}",
                "response": {
                    "enum": "documentType"
                }
            }
        },
        "documentType": {
            "ui:widget": "select",
            "ui:placeholder": "Select a type",
            "ui:events": [
                {
                    "taskEventType": "onChange",
                    "dataKey": "documentType",
                    "responseType": "formData",
                    "responseData": "value"
                }
            ],
            "ui:props": {
                "apiUrl": "document/v3/documentType/search?limit=100&offset=0",
                "apiMethod": "post",
                "apiPayload": {
                    "parentCarrierCode": "{{customData.carrier}}",
                    "documentType": "{{value}}"
                },
                "dataKey": "formNumberEnum",
                "responseType": "schema",
                "responseData": "{{data.documentTypeList}}",
                "response": {
                    "enum": "",
                    "enumNames": "formNumber"
                }
            }
        },
        "formNumberSelect": {
            "ui:options": {
                "omitValue": true
            },
            "ui:placeholder": "Select a form number",
            "ui:events": [
                {
                    "taskEventType": "onChange",
                    "dataKey": "documentTypeDescription",
                    "responseType": "formData",
                    "responseData": "documentTypeDescription"
                },
                {
                    "taskEventType": "onChange",
                    "dataKey": "formNumber",
                    "responseType": "formData",
                    "responseData": "formNumber"
                }
            ]
        },
        "docAccessLevel": {
            "ui:placeholder": "Select"
        },
        "sourceSystem": {
            "ui:widget": "hidden"
        }
    }
}
