                    "type": "object",
                    "title": "",
                    "properties": {
                        "issue": {
                            "type": "string",
                            "title": "Issue"
                        },
                        "rule": {
                            "type": "string",
                            "title": "Rule"
                        },
                        "applicationValue": {
