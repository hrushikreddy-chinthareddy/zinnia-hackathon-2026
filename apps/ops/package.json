    "lint-staged": {
        "src/**/*.{css,scss}": [
            "prettier --write"
        ],
        "src/**/*.{ts,tsx,js,jsx}": [
            "cross-env ESLINT_USE_FLAT_CONFIG=true eslint --fix",
            "prettier --write"
        ]
    },
    "name": "ops",
    "private": true,
    "scripts": {
        "build": "pnpm run build-api-types-if-needed && next build --no-lint",
        "build-storybook": "pnpm run build-api-types-if-needed && storybook build",
        "dev": "pnpm run build-api-types-if-needed && next dev",
        "lint": "pnpm run build-api-types-if-needed && cross-env NODE_OPTIONS=--max-old-space-size=8192 ESLINT_USE_FLAT_CONFIG=true eslint . --max-warnings=0",
        "lint-staged": "pnpm run build-api-types-if-needed && lint-staged",
        "lint:fix": "pnpm run build-api-types-if-needed && cross-env NODE_OPTIONS=--max-old-space-size=8192 ESLINT_USE_FLAT_CONFIG=true eslint . --fix",
        "lint:test": "pnpm run build-api-types-if-needed && cross-env NODE_OPTIONS=--max-old-space-size=8192 ESLINT_USE_FLAT_CONFIG=true eslint 'src/**/*.{js,ts,jsx,tsx}' --max-warnings=0 --no-ignore",
        "login:gh-pkg": "pnpm login --scope=@zinnia --registry=https://npm.pkg.github.com",
        "pre-commit": "pnpm run build-api-types-if-needed && pnpm run lint-staged",
        "pre-push": "pnpm run build-api-types-if-needed && turbo prettier lint check-types test",
        "prettier": "pnpm run build-api-types-if-needed && prettier --check --cache --loglevel=warn ./src",
        "prettier:fix": "pnpm run build-api-types-if-needed && prettier --write --cache ./src",
        "start": "pnpm run build-api-types-if-needed && next start",
        "storybook": "pnpm run build-api-types-if-needed && storybook dev -p 6006",
        "test": "pnpm run build-api-types-if-needed && jest --verbose=true --maxWorkers=50% --coverage",
        "test-watch": "pnpm run build-api-types-if-needed && pnpm test -- --watch",
        "test-vitest": "pnpm run build-api-types-if-needed && vitest",
        "tokenize": "style-dictionary build",
        "check-types": "pnpm run build-api-types-if-needed && tsc --project ./tsconfig.json",
        "build-api-types": "node ./scripts/build-types-with-timing.mjs",
        "update-api-spec": "node ./scripts/update-type-definition.mjs",
        "generate-api-types": "node ./scripts/generate-all-types.mjs",
        "clean-api-types": "node ./scripts/clean-api-types.mjs",
        "build-api-types-if-needed": "node ./scripts/build-api-types-if-needed.mjs",
        "playwright": "playwright test",
        "playwright:ui": "playwright test --ui",
        "playwright:debug": "playwright test --debug"
    },
    "version": "2.36.0"
}
