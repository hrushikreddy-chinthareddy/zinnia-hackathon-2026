            "prettier --write"
        ]
    },
    "name": "ops",
    "private": true,
    "scripts": {
        "build": "next build --no-lint",
        "build-storybook": "storybook build",
        "clean": "./scripts/clean.sh",
        "cypress": "bash ./e2e/scripts/cypress-tests.sh",
        "cypress:local": "bash ./e2e/scripts/cypress-tests.sh --local",
        "dev": "next dev",
        "lint": "next lint",
        "lint-staged": "lint-staged",
        "lint:fix": "next lint --fix",
        "lint:test": "eslint 'src/**/*.{js,ts,jsx,tsx}' --max-warnings=0 --no-ignore",
        "login:gh-pkg": "pnpm login --scope=@zinnia --registry=https://npm.pkg.github.com",
        "orval": "orval",
        "pre-commit": "pnpm run lint-staged",
        "pre-push": "pnpm --silent prettier && pnpm lint && pnpm check-types && pnpm test",
        "prettier": "prettier --check --cache --loglevel=warn ./src",
        "prettier:fix": "prettier --write --cache ./src",
        "start": "next start",
        "storybook": "storybook dev -p 6006",
        "test": "cd ../.. && npx turbo run build --filter=ops && cd apps/ops && jest --verbose=true --maxWorkers=50% --coverage",
        "test-watch": "pnpm test -- --watch",
        "tokenize": "style-dictionary build",
        "check-types": "tsc --project ./tsconfig.json"
    },
    "version": "2.16.0"
