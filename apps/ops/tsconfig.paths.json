            "@xd/*": ["../../packages/*"],
            "@xd-components/*": ["../../packages/xd-components/src/*"],
            "@xd/components/*": ["../../packages/xd-components/src/components/*"],
            "@xd/hooks/*": ["../../packages/xd-components/src/hooks/*"],
