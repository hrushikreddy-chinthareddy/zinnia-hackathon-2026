{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@deps/*": ["./src/*"],
            "@vitest/*": ["./vitest/*"],
            "@zinnia/api-types/types/*": [
                "./api-types/generated-types/*/index"
            ],
            "components/*": ["./src/components/*"],
            "models/*": ["./src/models/*"],
            "utils/*": ["./src/utils/*"],
            "routing/*": ["./src/routing/*"],
            "queries/*": ["./src/queries/*"],
            "shared/*": ["./src/shared/*"],
            "navigation/*": ["./src/navigation/*"],
            "pages/*": ["./src/pages/*"],
            "config/*": ["./src/config/*"]
        }
    }
}
