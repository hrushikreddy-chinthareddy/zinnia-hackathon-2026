            "routing/*": ["./src/routing/*"],
            "queries/*": ["./src/queries/*"],
            "shared/*": ["./src/shared/*"],
            "navigation/*": ["./src/navigation/*"],
            "pages/*": ["./src/pages/*"],
            "config/*": ["./src/config/*"]
