# This file is committed to the repo, as these are example values for connecting to a development backend;
# If you're just getting started, you probably just want to `cp example.env.development.local .env.development.local`
# and add the appropriate secrets in that file

AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://login.qa.zinnia.com

NEXT_PUBLIC_BACKEND_URL=https://qa.api.zinnia.io
NEXT_PUBLIC_SE2_BACKEND_URL=https://qa.api.zinnia.io
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Optional: ephemeral AI RJSF dev store (run `pnpm run rjsf-dev-store` in apps/ops). Omit if unused.
# NEXT_PUBLIC_RJSF_DEV_STORE_URL=http://127.0.0.1:3847
NEXT_PUBLIC_THEME=zinnia
NEXT_PUBLIC_S3_BUCKET_BASE_URL=https://portal-frontend-static-content.s3.amazonaws.com
PINO_LOG_LEVEL=info
NEXT_PUBLIC_APEX_URL=https://farmersagent--faqa.sandbox.my.salesforce.com/
