      "PartySearchResponse": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number",
            "description": "result count, if more results than limit will equal limit"
          },
          "next": {
            "type": "string",
            "description": "path for next page, includes full path and query parameters"
          },
          "previous": {
            "type": "string",
            "description": "path for previous page, includes full path and query parameters"
          },
          "results": {
            "description": "array of policy reference data",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartyReferenceDataModel"
            }
          }
        },
        "required": [
          "count",
          "next",
          "previous",
          "results"
        ]
      },
      "BatchGetPartyRequest": {
        "type": "object",
        "properties": {
          "partyIds": {
            "description": "List of party IDs to fetch (maximum 250)",
            "example": [
              "123456789",
              "987654321"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "array",
            "description": "Optional list of fields to include in the response",
            "example": [
              "firstName",
              "lastName",
              "email",
              "fullName"
            ],
            "items": {
              "type": "string",
              "enum": [
                "partyId",
                "firstName",
                "lastName",
                "fullName",
                "entityName",
                "email",
                "phoneNumber",
                "taxId",
                "taxIdType",
                "npn",
                "lastUpdated",
                "createdAt",
                "alias",
                "id"
              ]
            }
          }
        },
        "required": [
          "partyIds"
        ]
      },
      "BatchGetPartyResponse": {
        "type": "object",
        "properties": {
          "parties": {
            "type": "object",
            "description": "List of party information",
            "additionalProperties": true,
            "example": {
              "123456789": {
                "firstName": "John",
                "lastName": "Doe",
                "id": "123456789"
              },
              "987654321": {
                "firstName": "Jane",
                "lastName": "Smith",
                "id": "987654321"
              }
            }
          },
          "partiesNotFound": {
            "description": "List of party IDs that were not found",
            "example": [
              "111111111"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "parties",
          "partiesNotFound"
        ]
