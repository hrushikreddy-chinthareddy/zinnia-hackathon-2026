{
  "openapi": "3.0.1",
  "info": {
    "title": "Contact Management API",
    "description": "Contact Management API documentation with security",
    "version": "2.0"
  },
  "servers": [
    {
      "url": "http://localhost:8090",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Contact Master",
      "description": "APIs for managing contact master records"
    }
  ],
  "paths": {
    "/v2/contacts/{id}": {
      "get": {
        "tags": ["Contact Master"],
        "summary": "Search contact by ID",
        "description": "Retrieves contact details for the given contact ID",
        "operationId": "searchContactById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-correlation-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved contact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactMasterResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": ["Contact Master"],
        "summary": "Update existing contact",
        "description": "Updates an existing contact's metadata based on the provided contact ID",
        "operationId": "updateContactById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactMasterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully updated contact",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Invalid input data"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v2/contacts": {
      "post": {
        "tags": ["Contact Master"],
        "summary": "Create a new contact",
        "description": "Creates a new contact record using the provided metadata. Required fields include personal information such as name, email, and phone number.",
        "operationId": "createContact",
        "parameters": [
          {
            "name": "x-correlation-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactMasterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successfully created contact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactMasterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v2/contacts/search": {
      "post": {
        "tags": ["Contact Master"],
        "summary": "Search contacts with filters",
        "description": "Returns a list of contacts matching the provided filters, pagination, and sorting options",
        "operationId": "searchContacts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactFilterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ContactSearchResult"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/contacts/health": {
      "get": {
        "tags": ["health-contact-controller"],
        "operationId": "checkHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "street1": {
            "type": "string",
            "description": "Primary street address",
            "example": "123 Main St"
          },
          "street2": {
            "type": "string",
            "description": "Secondary street address (e.g., apartment or suite number)",
            "example": "Apt 4B"
          },
          "city": {
            "type": "string",
            "description": "City name",
            "example": "New York"
          },
          "state": {
            "type": "string",
            "description": "State of residence",
            "example": "NY"
          },
          "zipCode": {
            "type": "string",
            "description": "ZIP code",
            "example": "10001"
          }
        },
        "description": "Address information of the contact"
      },
      "ContactMasterRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "Source metadata as key-value pairs"
            },
            "description": "Source metadata as key-value pairs"
          },
          "type": {
            "type": "string",
            "description": "Type of contact",
            "example": "CONTACT",
            "enum": ["CONTACT", "LEAD"]
          },
          "personalInfo": {
            "$ref": "#/components/schemas/PersonalInfo"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "productInfo": {
            "$ref": "#/components/schemas/ProductInfo"
          },
          "occupation": {
            "type": "string",
            "description": "Occupation of the contact",
            "example": "Software Engineer"
          },
          "status": {
            "type": "string",
            "description": "Status of the contact",
            "example": "ACTIVE",
            "enum": ["active", "inactive"]
          },
          "createdAt": {
            "type": "string",
            "description": "Timestamp of when the record was created",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "Timestamp of when the record was last updated",
            "format": "date-time"
          }
        },
        "description": "Request payload for creating or updating a Contact"
      },
      "PersonalInfo": {
        "required": ["email", "firstName", "lastName", "phoneNumber"],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "First name of the contact",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the contact",
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "description": "Email address of the contact",
            "example": "john.doe@example.com"
          },
          "phoneNumber": {
            "pattern": "^(\\d{3}-\\d{3}-\\d{4})$",
            "type": "string",
            "description": "Phone number in format XXX-XXX-XXXX",
            "example": "123-456-7890"
          },
          "dateOfBirth": {
            "type": "string",
            "description": "Date of birth of the contact in ISO format (YYYY-MM-DD)",
            "example": "1990-01-01"
          },
          "gender": {
            "type": "string",
            "description": "Gender of the contact",
            "example": "MALE",
            "enum": ["M", "F", "MALE", "FEMALE", "OTHER"]
          },
          "maritalStatus": {
            "type": "string",
            "description": "Marital status as Yes or No",
            "example": "YES",
            "enum": ["Y", "N", "YES", "NO"]
          }
        },
        "description": "Personal information of the contact"
      },
      "ProductInfo": {
        "type": "object",
        "properties": {
          "productVertical": {
            "type": "string",
            "description": "Vertical or category of the product",
            "example": "Insurance"
          },
          "product": {
            "type": "string",
            "description": "Product code or identifier",
            "example": "INS-001"
          },
          "productName": {
            "type": "string",
            "description": "Human-readable product name",
            "example": "Health Insurance Plan"
          }
        },
        "description": "Product-related information associated with the contact"
      },
      "ContactMasterResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "partyId": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "personalInfo": {
            "$ref": "#/components/schemas/PersonalInfo"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "productInfo": {
            "$ref": "#/components/schemas/ProductInfo"
          },
          "status": {
            "type": "string",
            "enum": ["active", "inactive"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContactFilterRequest": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Maximum number of results to return",
            "format": "int32",
            "example": 10
          },
          "offset": {
            "type": "integer",
            "description": "Number of results to skip",
            "format": "int32",
            "example": 0
          },
          "sortBy": {
            "type": "string",
            "description": "Field to sort by",
            "example": "createdAt"
          },
          "sortOrder": {
            "type": "string",
            "description": "Sort order: asc or desc",
            "example": "asc"
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          }
        },
        "description": "Request to filter and search contacts"
      },
      "Filters": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address to filter",
            "example": "john.doe@example.com"
          },
          "phoneNumber": {
            "type": "string",
            "description": "Phone number to filter",
            "example": "+911234567890"
          },
          "firstName": {
            "type": "string",
            "description": "First name of the contact",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the contact",
            "example": "Doe"
          },
          "productVertical": {
            "type": "string",
            "description": "Product vertical associated with the contact",
            "example": "Loans"
          },
          "status": {
            "type": "string",
            "description": "Status of the contact",
            "example": "ACTIVE"
          },
          "createdAtStart": {
            "type": "string",
            "description": "Start date for creation filter (ISO format)",
            "example": "2024-01-01T00:00:00"
          },
          "createdAtEnd": {
            "type": "string",
            "description": "End date for creation filter (ISO format)",
            "example": "2024-12-31T23:59:59"
          }
        },
        "description": "Filter fields for searching contacts"
      },
      "ContactSearchResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "partyId": {
            "type": "string"
          },
          "personalInfo": {
            "$ref": "#/components/schemas/PersonalInfo"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "productInfo": {
            "$ref": "#/components/schemas/ProductInfo"
          },
          "status": {
            "type": "string",
            "enum": ["active", "inactive"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContactSearchResult": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactSearchResponse"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "offset": {
            "type": "integer",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
