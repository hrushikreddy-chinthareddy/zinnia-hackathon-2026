{
  "name": "consumer-experience",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=32000' next dev",
    "dev:pretty-logs": "NODE_OPTIONS='--max-http-header-size=32000' next dev | pino-pretty -m message -i time -c",
    "dev-ssl": "NODE_OPTIONS='--max-http-header-size=32000' next dev --experimental-https --experimental-https-key ../sso-mpv/.cert/key.pem --experimental-https-cert ../sso-mpv/.cert/cert.pem",
    "build": "next build --no-lint",
    "start": "NODE_OPTIONS='--max-http-header-size=32000' next start",
    "check-types": "tsc --noemit",
    "lint": "next lint",
    "lint-staged": "lint-staged",
    "lint:fix": "next lint --fix",
    "prettier": "prettier --check --cache --log-level=warn ./src",
    "prettier:fix": "prettier --write --cache ./src",
    "test": "cd ../.. && npx turbo run build --filter=consumer-experience && cd apps/consumer-experience && jest",
    "test:watch": "jest --watch",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm lint && pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@datadog/browser-rum": "^5.17.1",
    "@hookform/resolvers": "^5.0.1",
    "@next/third-parties": "^14.2.3",
    "@optimizely/optimizely-sdk": "^5.3.3",
    "@panva/hkdf": "^1.1.1",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-popover": "^1.0.7",
    "@segment/analytics-next": "^1.76.0",
    "@storybook/addon-docs": "^9.0.1",
    "@tanstack/react-query": "^5.51.18",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/uuid": "^9.0.8",
    "@zinnia/api-types": "workspace:*",
    "@zinnia/bloom": "5.30.0",
    "@zinnia/utils": "workspace:*",
    "@zinnia/xd-components": "workspace:*",
    "clsx": "^2.1.0",
    "cookie": "^0.6.0",
    "dayjs": "^1.11.10",
    "file-saver": "^2.0.5",
    "filter": "^0.1.1",
    "jose": "^5.2.4",
    "js-cookie": "^3.0.5",
    "next": "14.2.25",
    "npm": "^10.2.5",
    "pino": "^8.20.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^9.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-idle-timer": "^5.7.2",
    "react-use": "^17.5.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.0",
    "@faker-js/faker": "^8.0.2",
    "@next/eslint-plugin-next": "^13.5.8",
    "@storybook/addon-a11y": "^9.0.1",
    "@storybook/addon-links": "^9.0.1",
    "@storybook/addon-onboarding": "^9.0.1",
    "@storybook/nextjs": "^9.0.1",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query-devtools": "^5.51.18",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.4.3",
    "@types/cookie": "^0.6.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@zinnia/eslint-config": "workspace:*",
    "@zinnia/jest-presets": "workspace:*",
    "@zinnia/prettier-config": "workspace:*",
    "@zinnia/typescript-config": "workspace:*",
    "autoprefixer": "^10.0.1",
    "canvas": "3.1.2",
    "chromatic": "^11.0.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-turbo": "2.1.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-check-file": "^2.8.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest-dom": "^5.1.0",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "eslint-plugin-storybook": "^9.0.1",
    "eslint-plugin-testing-library": "^6.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.2",
    "pino-pretty": "^13.0.0",
    "postcss": "^8",
    "postcss-nesting": "^12.0.2",
    "prettier": "^3.1.1",
    "storybook": "^9.0.1",
    "storybook-css-modules": "^1.0.8",
    "ts-jest": "^29.1.1",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "src/**/*.{css,scss}": [
      "prettier --write"
    ],
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
