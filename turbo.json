{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "JWT_SECRET",
        "AUTH0_COOKIE_DOMAIN",
        "AUTH0_ISSUER_BASE_URL",
        "AUTH0_CLIENT_ID",
        "AUTH0_CLIENT_SECRET",
        "AUTH0_AUDIENCE",
        "NEXT_PUBLIC_MOCK_API_REQUEST",
        "NEXT_PUBLIC_BACKEND_URL",
        "NEXT_PUBLIC_BASE_URL",
        "NODE_ENV",
        "SESSION_DURATION_IN_MINUTES",
        "CHECK_SESSION_THRESHOLD_IN_MINUTES",
        "NEXT_PUBLIC_AUTH0_BASE_URL",
        "AUTH0_SCOPE",
        "AUTH0_SESSION_NAME",
        "AUTH0_COOKIE_SECURE"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
