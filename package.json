{
  "name": "digital-experience-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=\"[HEAD^1]\"",
    "build:all": "turbo run build",
    "dev": "dotenv -- turbo run dev",
    "dev:ops": "pnpm run dev --filter ops",
    "test:ops": "turbo run test --filter ops",
    "cypress:ops": "npm --prefix apps/ops run cypress:local",
    "dev:consumer-experience": "pnpm run dev --filter consumer-experience",
    "dev:cui": "pnpm run dev --filter consumer-experience",
    "lint": "turbo run lint",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name 'dist' -type d -prune -exec rm -rf '{}' + && find . -name '.turbo' -type d -prune -exec rm -rf '{}' +",
    "test": "turbo run test",
    "build-storybook": "turbo run build-storybook",
    "link-package": "node ./scripts/link-package.mjs",
    "unlink-package": "node ./scripts/unlink-packages.mjs",
    "pre-commit": "turbo run pre-commit --filter=\"[HEAD^1]\"",
    "pre-push": "bash ./scripts/pre-push.sh",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@zinnia/typescript-config": "workspace:*",
    "dotenv-cli": "^7.3.0",
    "husky": "^8.0.3",
    "prettier": "^3.1.1",
    "turbo": "^2.0.4"
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=18"
  }
}
