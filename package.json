{
  "name": "digital-experience-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:ops": "turbo dev --filter ops",
    "dev:cui": "turbo dev --filter consumer-experience",
    "lint": "turbo lint",
    "clean": "node ./scripts/clean.mjs .next node_modules dist .turbo build",
    "test": "turbo test",
    "pre-commit": ".husky/pre-commit",
    "pre-push": ".husky/pre-push",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "prettier": "^3.1.1",
    "turbo": "^2.6.0"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "canvas": "npm:empty-npm-package@1.0.0"
    }
  }
}
