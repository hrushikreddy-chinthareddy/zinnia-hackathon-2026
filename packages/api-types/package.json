{
  "name": "@zinnia/api-types",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zinnia/digital-experience-monorepo.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./types/sor": "./dist/generated-types/sor/index.js",
    "./types/search": "./dist/generated-types/search/index.js",
    "./types/documents": "./dist/generated-types/documents/index.js",
    "./types/documents-v3": "./dist/generated-types/documents-v3/index.js",
    "./types/bpm": "./dist/generated-types/bpm/index.js",
    "./types/funds": "./dist/generated-types/funds/index.js",
    "./types/case": "./dist/generated-types/case/index.js",
    "./types/case-v2": "./dist/generated-types/case-v2/index.js",
    "./types/preferences": "./dist/generated-types/preferences/index.js",
    "./types/partyreference": "./dist/generated-types/partyreference/index.js",
    "./types/transaction-store": "./dist/generated-types/transaction-store/index.js",
    "./types/analytics": "./dist/generated-types/analytics/index.js",
    "./types/contact-management": "./dist/generated-types/contact-management/index.js",
    "./types/correspondence": "./dist/generated-types/correspondence/index.js",
    "./types/knowledgebase": "./dist/generated-types/knowledgebase/index.js",
    "./types/aggregation": "./dist/generated-types/aggregation/index.js",
    "./types/pom": "./dist/generated-types/pom/index.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ],
      "./types/sor": [
        "dist/generated-types/sor/index.d.ts"
      ],
      "./types/search": [
        "dist/generated-types/search/index.d.ts"
      ],
      "./types/documents": [
        "dist/generated-types/documents/index.d.ts"
      ],
      "./types/documents-v3": [
        "dist/generated-types/documents-v3/index.d.ts"
      ],
      "./types/bpm": [
        "dist/generated-types/bpm/index.d.ts"
      ],
      "./types/funds": [
        "dist/generated-types/funds/index.d.ts"
      ],
      "./types/case": [
        "dist/generated-types/case/index.d.ts"
      ],
      "./types/case-v2": [
        "dist/generated-types/case-v2/index.d.ts"
      ],
      "./types/transaction-store": [
        "dist/generated-types/transaction-store/index.d.ts"
      ],
      "./types/preferences": [
        "dist/generated-types/preferences/index.d.ts"
      ],
      "./types/partyreference": [
        "dist/generated-types/partyreference/index.d.ts"
      ],
      "./types/analytics": [
        "dist/generated-types/analytics/index.d.ts"
      ],
      "./types/contact-management": [
        "dist/generated-types/contact-management/index.d.ts"
      ],
      "./types/knowledgebase": [
        "dist/generated-types/knowledgebase/index.d.ts"
      ],
      "./types/correspondence": [
        "dist/generated-types/correspondence/index.d.ts"
      ],
      "./types/aggregation": [
        "dist/generated-types/aggregation/index.d.ts"
      ],
      "./types/pom": [
        "dist/generated-types/pom/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run update-spec && pnpm run generate-types:all && tsup --silent",
    "test": "echo ",
    "typecheck": "tsc --noEmit",
    "update-spec": "node ./src/update-type-definition.mjs",
    "generate-types:documents": "npx openapi --input ./src/api-spec-documents.yaml --output ./src/generated-types/documents --exportCore false --exportServices false",
    "generate-types:documents-v3": "npx openapi --input ./src/api-spec-documents-v3.yaml --output ./src/generated-types/documents-v3 --exportCore false --exportServices false",
    "generate-types:sor": "npx openapi --input ./src/api-spec-sor.updated.json --output ./src/generated-types/sor --exportCore false --exportServices false",
    "generate-types:search": "npx openapi --input ./src/api-spec-search.yaml --output ./src/generated-types/search --exportCore false --exportServices false",
    "generate-types:bpm": "npx openapi --input ./src/api-spec-bpm.yaml --output ./src/generated-types/bpm --exportCore false --exportServices false",
    "generate-types:funds": "npx openapi --input ./src/api-spec-funds.yaml --output ./src/generated-types/funds --exportCore false --exportServices false",
    "generate-types:case": "npx openapi --input ./src/api-spec-case.yaml --output ./src/generated-types/case --exportCore false --exportServices false",
    "generate-types:case-v2": "npx openapi --input ./src/api-spec-case-v2.yaml --output ./src/generated-types/case-v2 --exportCore false --exportServices false",
    "generate-types:transaction-store": "npx openapi --input ./src/api-spec-transaction-store.yaml --output ./src/generated-types/transaction-store --exportCore false --exportServices false",
    "generate-types:preferences": "npx openapi --input ./src/api-spec-preferences.yaml --output ./src/generated-types/preferences --exportCore false --exportServices false",
    "generate-types:partyreference": "npx openapi --input ./src/api-spec-partyreference.json --output ./src/generated-types/partyreference --exportCore false --exportServices false",
    "generate-types:analytics": "npx openapi --input ./src/api-spec-analytics.yaml --output ./src/generated-types/analytics --exportCore false --exportServices false",
    "generate-types:contact-management": "npx openapi --input ./src/api-spec-contact-management.json --output ./src/generated-types/contact-management --exportCore false --exportServices false",
    "generate-types:knowledgebase": "npx openapi --input ./src/api-spec-knowledgebase.yaml --output ./src/generated-types/knowledgebase --exportCore false --exportServices false",
    "generate-types:correspondence": "npx openapi --input ./src/api-spec-correspondence.yaml --output ./src/generated-types/correspondence --exportCore false --exportServices false",
    "generate-types:aggregation": "npx openapi --input ./src/api-spec-aggregation.json --output ./src/generated-types/aggregation --exportCore false --exportServices false",
    "generate-types:pom": "npx openapi --input ./src/api-spec-pom.yaml --output ./src/generated-types/pom --exportCore false --exportServices false",
    "generate-types:all": "rimraf ./src/generated-types && pnpm run generate-types:sor && pnpm run generate-types:search && pnpm run generate-types:documents && pnpm run generate-types:documents-v3 && pnpm run generate-types:bpm && pnpm run generate-types:funds && pnpm run generate-types:case && pnpm run generate-types:case-v2 && pnpm run generate-types:preferences && pnpm run generate-types:partyreference && pnpm run generate-types:transaction-store && pnpm run generate-types:analytics && pnpm run generate-types:contact-management && pnpm run generate-types:correspondence && pnpm run generate-types:knowledgebase && pnpm run generate-types:aggregation && pnpm run generate-types:pom ",
    "clean": "rimraf ./dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@zinnia/typescript-config": "workspace:*",
    "openapi-typescript-codegen": "^0.26.0",
    "rimraf": "^6.1.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
