{
  "name": "@zinnia/api-types",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zinnia/digital-experience-monorepo.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./types/sor": "./dist/generated-types/sor/index.js",
    "./types/search": "./dist/generated-types/search/index.js",
    "./types/documents": "./dist/generated-types/documents/index.js",
    "./types/bpm": "./dist/generated-types/bpm/index.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ],
      "./types/sor": [
        "dist/generated-types/sor/index.d.ts"
      ],
      "./types/search": [
        "dist/generated-types/search/index.d.ts"
      ],
      "./types/documents": [
        "dist/generated-types/documents/index.d.ts"
      ],
      "./types/bpm": [
        "dist/generated-types/bpm/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run update-spec && pnpm run generate-types:all && tsup",
    "test": "echo ",
    "typecheck": "tsc --noEmit",
    "update-spec": "node ./src/update-type-definition.mjs",
    "generate-types:documents": "npx openapi --input ./src/api-spec-documents.json --output ./src/generated-types/documents --exportCore false --exportServices false;",
    "generate-types:sor": "npx openapi --input ./src/api-spec-sor.updated.json --output ./src/generated-types/sor --exportCore false --exportServices false;",
    "generate-types:search": "npx openapi --input ./src/api-spec-search.yaml --output ./src/generated-types/search --exportCore false --exportServices false;",
    "generate-types:bpm": "npx openapi --input ./src/api-spec-bpm.yaml --output ./src/generated-types/bpm --exportCore false --exportServices false;",
    "generate-types:all": "rm -rf ./src/generated-types && pnpm run generate-types:sor && pnpm run generate-types:search && pnpm run generate-types:documents && pnpm run generate-types:bpm",
    "clean": "rm -rf ./dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@zinnia/typescript-config": "workspace:*",
    "openapi-typescript-codegen": "^0.27.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
