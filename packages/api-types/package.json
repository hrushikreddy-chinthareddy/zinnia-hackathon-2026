      ],
      "./types/api-spec-pom": [
        "dist/generated-types/api-spec-pom/index.d.ts"
      ],
      "./types/api-spec-preferences": [
        "dist/generated-types/api-spec-preferences/index.d.ts"
      ],
      "./types/api-spec-search": [
        "dist/generated-types/api-spec-search/index.d.ts"
      ],
      "./types/api-spec-sor": [
        "dist/generated-types/api-spec-sor/index.d.ts"
      ],
