{
  "name": "@zinnia/api-types",
  "version": "0.0.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zinnia/digital-experience-monorepo.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "pnpm run update-spec && pnpm run generate-types && tsup --silent",
    "test": "echo ",
    "typecheck": "tsc --noEmit",
    "update-spec": "node ./src/update-type-definition.mjs",
    "generate-types": "node ./scripts/generate-all-types.mjs",
    "clean": "rimraf ./dist ./src/generated-types"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@zinnia/typescript-config": "workspace:*",
    "openapi-typescript-codegen": "^0.26.0",
    "rimraf": "^6.1.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./types/api-spec-aggregation": "./dist/generated-types/api-spec-aggregation/index.js",
    "./types/api-spec-analytics": "./dist/generated-types/api-spec-analytics/index.js",
    "./types/api-spec-bpm": "./dist/generated-types/api-spec-bpm/index.js",
    "./types/api-spec-case-v2": "./dist/generated-types/api-spec-case-v2/index.js",
    "./types/api-spec-case": "./dist/generated-types/api-spec-case/index.js",
    "./types/api-spec-contact-management": "./dist/generated-types/api-spec-contact-management/index.js",
    "./types/api-spec-correspondence": "./dist/generated-types/api-spec-correspondence/index.js",
    "./types/api-spec-documents-v3": "./dist/generated-types/api-spec-documents-v3/index.js",
    "./types/api-spec-documents": "./dist/generated-types/api-spec-documents/index.js",
    "./types/api-spec-funds": "./dist/generated-types/api-spec-funds/index.js",
    "./types/api-spec-knowledgebase": "./dist/generated-types/api-spec-knowledgebase/index.js",
    "./types/api-spec-partyreference": "./dist/generated-types/api-spec-partyreference/index.js",
    "./types/api-spec-pom": "./dist/generated-types/api-spec-pom/index.js",
    "./types/api-spec-preferences": "./dist/generated-types/api-spec-preferences/index.js",
    "./types/api-spec-search": "./dist/generated-types/api-spec-search/index.js",
    "./types/api-spec-sor": "./dist/generated-types/api-spec-sor/index.js",
    "./types/api-spec-transaction-store": "./dist/generated-types/api-spec-transaction-store/index.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ],
      "./types/api-spec-aggregation": [
        "dist/generated-types/api-spec-aggregation/index.d.ts"
      ],
      "./types/api-spec-analytics": [
        "dist/generated-types/api-spec-analytics/index.d.ts"
      ],
      "./types/api-spec-bpm": [
        "dist/generated-types/api-spec-bpm/index.d.ts"
      ],
      "./types/api-spec-case-v2": [
        "dist/generated-types/api-spec-case-v2/index.d.ts"
      ],
      "./types/api-spec-case": [
        "dist/generated-types/api-spec-case/index.d.ts"
      ],
