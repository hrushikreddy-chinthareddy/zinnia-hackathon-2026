  "info": {
    "title": "Party Reference Service",
    "description": "Party ID generation service to create/retrieve/import cross reference unique identifier for parties",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Party Reference",
      "description": ""
    }
  ],
  "servers": [
    {
      "url": "https://qa.api.zinnia.io"
    }
  ],
  "components": {
    "securitySchemes": {
      "Auth0": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://login.qa.zinnia.com/.well-known/openid-configuration",
        "x-kong-security-openid-connect": {
          "config": {
            "run_on_preflight": true,
            "scopes_claim": [
              "https://qa.api.zinnia.io/permissions"
            ],
            "audience_claim": [
              "aud"
            ],
            "audience_required": [
              "https://qa.api.zinnia.io"
            ],
            "auth_methods": [
              "bearer"
            ],
            "scopes": []
          },
          "enabled": true,
          "protocols": [
            "grpc",
            "grpcs",
            "http",
            "https"
          ]
        }
      }
    },
    "schemas": {
      "ApplicationPartyReferenceRequest": {
        "type": "object",
        "properties": {
          "authId": {
            "type": "string",
            "description": "auth id of the party",
            "example": "000000"
          },
          "entityName": {
            "type": "string",
            "description": "entity name of the party",
            "example": "Nick"
          }
        },
        "required": [
          "authId",
          "entityName"
        ]
      },
      "UserPartyReferenceRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "party first name",
            "example": "Nick"
          },
          "lastName": {
            "type": "string",
            "description": "party last name",
            "example": "Burdell"
          },
          "email": {
            "type": "string",
            "description": "email address of the party",
            "example": "email"
          },
          "authId": {
            "type": "string",
            "description": "auth id of the party",
            "example": "000000000"
          },
          "phoneNumber": {
            "type": "string",
            "description": "phone number of the party",
            "example": "000000000"
          }
        },
        "required": [
          "email",
          "authId"
        ]
      },
      "AliasModel": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "alias first name",
            "example": "Nick"
          },
          "lastName": {
            "type": "string",
            "description": "alias last name",
            "example": "Burdell"
          },
          "email": {
            "type": "string",
            "description": "alias email address",
            "example": "nick.burdell@gmail.com"
          },
          "phoneNumber": {
            "type": "string",
            "description": "alias phone number",
            "example": "123-4567-8909"
          },
          "policyNumber": {
            "type": "string",
            "description": "alias policyNumber",
            "example": "AU1234"
          },
          "planCode": {
            "type": "string",
            "description": "alias planCode",
            "example": "12345"
          },
          "partyId": {
            "type": "string",
            "description": "alias partyId from SOR",
            "example": "Beneficiary_Party"
          },
          "partyRoles": {
            "description": "Roles associated with the user",
            "example": [
              "OWNER"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "carrier": {
            "type": "string",
            "description": "alias carrier code",
            "example": "sbgc"
          },
          "masterAgentNumber": {
            "type": "string",
            "description": "alias master agent number",
            "example": "000000000"
          },
          "externalId": {
            "type": "string",
            "description": "alias external id",
            "example": "000000000"
          },
          "agentOrganizationName": {
            "type": "string",
            "description": "alias agent organization name",
            "example": "name"
          }
        }
      },
      "CreatePartyReferenceDataModel": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string",
            "description": "number/subjective id of party",
            "example": "127147468264"
          },
          "authId": {
            "description": "user id in authentication server",
            "example": [
              "auth0|64ac5577bb372f7bd880d457"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "firstName": {
            "type": "string",
            "description": "authentication user first name",
            "example": "Nick"
          },
          "lastName": {
            "type": "string",
            "description": "authentication user last name",
            "example": "Burdell"
          },
          "entityName": {
            "type": "string",
            "description": "authentication entity name",
            "example": "Burdell"
          },
          "email": {
            "type": "string",
            "description": "authentication user email address",
            "example": "ciam@zinnia.com"
          },
          "phoneNumber": {
            "type": "string",
            "description": "authentication user phone number",
            "example": "Burdell"
          },
          "taxId": {
            "type": "string",
            "description": "Tax Id of party holder, masked on return",
            "example": "000000000"
          },
          "taxIdType": {
            "type": "string",
            "description": "Type of Tax id, SSN, EIN, etc",
            "example": "SSN"
          },
          "alias": {
            "description": "Party Alias List for custom parties by unique policy",
            "example": [
              {}
            ],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AliasModel"
            }
          },
          "lastUpdated": {
            "format": "date-time",
            "type": "string",
            "description": "last time party was updated"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "time party was created"
          }
        },
        "required": [
          "alias"
        ]
      },
      "PartyReferenceDataModel": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string",
            "description": "number/subjective id of party",
            "example": "127147468264"
          },
          "authId": {
            "description": "user id in authentication server",
            "example": [
              "auth0|64ac5577bb372f7bd880d457"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "firstName": {
            "type": "string",
            "description": "authentication user first name",
            "example": "Nick"
          },
          "lastName": {
            "type": "string",
            "description": "authentication user last name",
            "example": "Burdell"
          },
          "entityName": {
            "type": "string",
            "description": "authentication entity name",
            "example": "Burdell"
          },
          "email": {
            "type": "string",
            "description": "authentication user email address",
            "example": "ciam@zinnia.com"
          },
          "phoneNumber": {
            "type": "string",
            "description": "authentication user phone number",
            "example": "Burdell"
          },
          "taxId": {
            "type": "string",
            "description": "Tax Id of party holder, masked on return",
            "example": "000000000"
          },
          "taxIdType": {
            "type": "string",
            "description": "Type of Tax id, SSN, EIN, etc",
            "example": "SSN"
          },
          "alias": {
            "description": "Party Alias List for custom parties by unique policy",
            "example": [
              {}
            ],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AliasModel"
            }
          },
          "lastUpdated": {
            "format": "date-time",
            "type": "string",
            "description": "last time party was updated"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "time party was created"
          },
          "id": {
            "type": "string",
            "description": "reference id of the party, fully unique",
            "example": "3cc99edada4f4a88be77cef53ba0b3fd"
          }
        },
        "required": [
          "alias"
        ]
      },
      "PatchPartyReferenceDataModel": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string",
            "description": "number/subjective id of party",
            "example": "127147468264"
          },
          "firstName": {
            "type": "string",
            "description": "authentication user first name",
            "example": "Nick"
          },
          "lastName": {
            "type": "string",
            "description": "authentication user last name",
            "example": "Burdell"
          },
          "entityName": {
            "type": "string",
            "description": "authentication entity name",
            "example": "Burdell"
          },
          "phoneNumber": {
            "type": "string",
            "description": "authentication user phone number",
            "example": "Burdell"
          },
          "taxId": {
            "type": "string",
            "description": "Tax Id of party holder, masked on return",
            "example": "000000000"
          },
          "taxIdType": {
            "type": "string",
            "description": "Type of Tax id, SSN, EIN, etc",
            "example": "SSN"
          },
          "alias": {
            "description": "Party Alias List for custom parties by unique policy",
            "example": [
              {}
            ],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AliasModel"
            }
          },
          "lastUpdated": {
            "format": "date-time",
            "type": "string",
            "description": "last time party was updated"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "time party was created"
          }
        },
        "required": [
          "alias"
        ]
      },
      "CreatePartyReferenceErrorModel": {
        "type": "object",
        "properties": {
          "referenceData": {
            "$ref": "#/components/schemas/CreatePartyReferenceDataModel"
          },
          "message": {
            "type": "string",
            "example": "Identical party reference already exists- reference id: 3cc99edada4f4a88be77cef53ba0b3fd"
          }
        },
        "required": [
          "referenceData",
          "message"
        ]
      },
      "BulkUploadResponse": {
        "type": "object",
        "properties": {
          "inserted": {
            "description": "Party reference data successfully added during upload",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartyReferenceDataModel"
            }
          },
          "errors": {
            "description": "Invalid party reference data that couldn't be inserted",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatePartyReferenceErrorModel"
            }
          }
        },
        "required": [
          "inserted",
          "errors"
        ]
      },
      "PartySearchRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "party first name"
          },
          "partyId": {
            "type": "string",
            "description": "number/subjective id of party"
          },
          "lastName": {
            "type": "string",
            "description": "party last name"
          },
          "lastUpdated": {
            "format": "date-time",
            "type": "string",
            "description": "last time party was updated"
          },
          "taxId": {
            "type": "string",
            "description": "party tax id"
          },
          "taxIdType": {
            "type": "string",
            "description": "party tax id type"
          },
          "id": {
            "type": "string",
            "description": "reference id of the party, fully unique"
          },
          "email": {
            "type": "string",
            "description": "email address of the party"
          },
          "entityName": {
            "type": "string",
            "description": "entity name of the party"
          },
          "authId": {
            "type": "string",
            "description": "auth id of the party"
          },
          "policyNumber": {
            "type": "string",
            "description": "policy/contract number"
          },
          "planCode": {
            "type": "string",
            "description": "plan code"
          }
        }
      },
      "PartySearchResponse": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number",
            "description": "result count, if more results than limit will equal limit"
          },
          "next": {
            "type": "string",
            "description": "path for next page, includes full path and query parameters"
          },
          "previous": {
            "type": "string",
            "description": "path for previous page, includes full path and query parameters"
          },
          "results": {
            "description": "array of policy reference data",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartyReferenceDataModel"
            }
          }
        },
        "required": [
          "count",
          "next",
          "previous",
          "results"
        ]
      },
      "PatchPartyReferenceEmailDataModel": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "authentication user email address",
            "example": "ciam@zinnia.com"
          }
        },
        "required": [
          "email"
        ]
      }
    }
  }
}