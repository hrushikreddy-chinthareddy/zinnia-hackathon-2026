{
  "name": "@zinnia/utils",
  "version": "0.0.12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zinnia/digital-experience-monorepo.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "pnpm run watch",
    "watch": "tsup --watch",
    "lint": "eslint --no-ignore 'src/**/*.{js,ts,jsx,tsx}'",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "@zinnia/jest-presets/node"
  },
  "dependencies": {
    "@zinnia/api-types": "workspace:*",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@zinnia/eslint-config": "workspace:*",
    "@zinnia/jest-presets": "workspace:*",
    "@zinnia/typescript-config": "workspace:*",
    "jest": "^29.7.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
