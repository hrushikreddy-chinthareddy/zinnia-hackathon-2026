{
  "extends": "@zinnia/typescript-config/react-library",
  "compilerOptions": {
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@tokens/*": ["./src/tokens/style-dictionary"]
    }
  },
  "types": ["node", "jest", "@testing-library/jest-dom"],
  "include": ["src", "vite.config.ts"],
  "exclude": ["**/node_modules/**"]
}
