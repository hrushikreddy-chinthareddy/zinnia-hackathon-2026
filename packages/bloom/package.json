{
  "name": "@zinnia/bloom",
  "version": "0.0.57",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zinnia/digital-experience-monorepo.git"
  },
  "homepage": "https://zinnia-design-system.supernova-docs.io/",
  "author": {
    "name": "Ximena Girasol🌻",
    "email": "ximena.girasol@zinnia.com"
  },
  "contributors": [
    {
      "name": "Caryn McCarthy",
      "email": "caryn.mccarthy@zinnia.com"
    },
    {
      "name": "Julie Bradley",
      "email": "julie.bradley@zinnia.com"
    }
  ],
  "main": "dist/bloom.cjs",
  "module": "dist/bloom.js",
  "types": "dist/bloom.d.ts",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./src/bloom.tsx"
    },
    "./css": "./src/tokens/css/index.css",
    "./bloom-css": {
      "import": "./dist/bloom.css",
      "require": "./dist/bloom.css"
    },
    "./component-styles": "./dist/components.css",
    "./bloom-component-styles": {
      "import": "./dist/components.css",
      "require": "./dist/components.css"
    },
    "./components": {
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./internal/components": {
      "import": "./src/components/index.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/bloom.d.ts"
      ],
      "./components": [
        "dist/components.d.ts"
      ],
      "./internal/components": [
        "dist/components.d.ts"
      ]
    }
  },
  "private": false,
  "type": "module",
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm run test",
    "dev": "vite",
    "test": "echo \"no tests\" && exit 0",
    "build": "tsc && vite build",
    "build:watch": "tsc && vite build --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "storybook": "storybook dev --no-open -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "changelog": "npx auto-changelog"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-toggle-group": "^1.0.4",
    "clsx": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-use": "^17.5.0",
    "uuid": "^9.0.1",
    "vite-plugin-svgr": "^4.2.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.6.4",
    "@storybook/addon-interactions": "^7.6.4",
    "@storybook/addon-links": "^7.6.4",
    "@storybook/addon-mdx-gfm": "^7.6.4",
    "@storybook/blocks": "^7.6.4",
    "@storybook/manager-api": "^7.6.4",
    "@storybook/react": "^7.6.4",
    "@storybook/react-vite": "^7.6.4",
    "@storybook/testing-library": "^0.2.2",
    "@storybook/theming": "^7.6.4",
    "@types/css-modules": "^1.0.5",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.8",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.2.0",
    "auto-changelog": "^2.4.0",
    "chromatic": "^10.3.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "eslint-plugin-storybook": "^0.6.15",
    "lodash": "^4.17.21",
    "semantic-release": "^23.0.2",
    "storybook": "^7.6.4",
    "typescript": "^5.2.2",
    "vite": "^5.0.12",
    "vite-plugin-dts": "^3.7.2",
    "vite-plugin-lib-inject-css": "^1.3.0"
  },
  "bugs": {
    "url": "https://github.com/zinnia/digital-experience-monorepo/issues"
  },
  "readme": "ERROR: No README data found!",
  "auto-changelog": {
    "output": "src/stories/CHANGELOG.md",
    "template": "keepachangelog",
    "unreleased": true,
    "commitLimit": false,
    "issuePattern": "[A-Z]+-\\d+",
    "issueUrl": "https://zinnia.atlassian.net/browse/{id}"
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      {
        "name": "dev",
        "prerelease": true
      }
    ]
  }
}
